  <script is:inline>
  (function(){
    // Counter
    var el = document.getElementById('mcert-counter');
    if(el){ var s=null,t=163,d=1800; function anim(ts){if(!s)s=ts;var p=Math.min((ts-s)/d,1),e=1-Math.pow(1-p,3);el.textContent=Math.floor(e*t);if(p<1)requestAnimationFrame(anim);} requestAnimationFrame(anim); }

    // Particles
    var pc=document.getElementById('mhero-particles');
    if(pc){for(var i=0;i<28;i++){var p=document.createElement('div');p.className='mparticle';p.style.cssText='left:'+Math.random()*100+'%;top:'+Math.random()*100+'%;width:'+(Math.random()*4+2)+'px;height:'+(Math.random()*4+2)+'px;animation-delay:'+Math.random()*4+'s;animation-duration:'+(Math.random()*6+4)+'s;opacity:'+(Math.random()*0.5+0.2)+';';pc.appendChild(p);}}

    // Filter & Search
    var cards=Array.from(document.querySelectorAll('.mcert-card'));
    var searchInput=document.getElementById('mcert-search');
    var clearBtn=document.getElementById('mclear-search');
    var filterBtns=document.querySelectorAll('.mcat-btn');
    var countEl=document.getElementById('mresults-count');
    var emptyEl=document.getElementById('mempty-state');
    var gridEl=document.getElementById('mcerts-grid');
    var cf='all', cs='';

    function applyFilters(){
      var v=0;
      cards.forEach(function(c){
        var cat=c.dataset.category||'';
        var ttl=c.dataset.title||'';
        var mf=cf==='all'||cat===cf;
        var ms=!cs||ttl.includes(cs.toLowerCase());
        if(mf&&ms){c.style.display='';c.classList.add('min-view');v++;}
        else{c.style.display='none';c.classList.remove('min-view');}
      });
      if(countEl)countEl.textContent=v+' certificado'+(v!==1?'s':'');
      if(emptyEl)emptyEl.style.display=v===0?'flex':'none';
      if(gridEl)gridEl.style.display=v===0?'none':'';
    }

    filterBtns.forEach(function(btn){
      btn.addEventListener('click',function(){
        filterBtns.forEach(function(b){b.classList.remove('active');});
        btn.classList.add('active');
        cf=btn.dataset.filter||'all';
        applyFilters();
      });
    });

    if(searchInput){
      searchInput.addEventListener('input',function(){
        cs=searchInput.value.trim();
        if(clearBtn)clearBtn.style.display=cs?'':'none';
        applyFilters();
      });
    }
    if(clearBtn){
      clearBtn.addEventListener('click',function(){
        if(searchInput){searchInput.value='';cs='';}
        clearBtn.style.display='none';
        applyFilters();
      });
    }

    // View toggle
    var gBtn=document.getElementById('mview-grid');
    var lBtn=document.getElementById('mview-list');
    if(gBtn&&lBtn&&gridEl){
      gBtn.addEventListener('click',function(){gBtn.classList.add('active');lBtn.classList.remove('active');gridEl.classList.remove('mlist-view');});
      lBtn.addEventListener('click',function(){lBtn.classList.add('active');gBtn.classList.remove('active');gridEl.classList.add('mlist-view');});
    }

    // Reset
    var resetBtn=document.getElementById('mbtn-reset');
    if(resetBtn){
      resetBtn.addEventListener('click',function(){
        filterBtns.forEach(function(b){b.classList.toggle('active',b.dataset.filter==='all');});
        cf='all';cs='';
        if(searchInput)searchInput.value='';
        if(clearBtn)clearBtn.style.display='none';
        applyFilters();
      });
    }

    // Intersection reveal
    var obs=new IntersectionObserver(function(entries){
      entries.forEach(function(e){if(e.isIntersecting){e.target.classList.add('min-view');obs.unobserve(e.target);}});
    },{threshold:0.04});
    cards.forEach(function(c){obs.observe(c);});

    // Download flash
    document.querySelectorAll('.mbtn-dl').forEach(function(btn){
      btn.addEventListener('click',function(){
        btn.classList.add('mdl-done');
        var span=btn.querySelector('span');
        var orig=span.textContent;
        span.textContent='✓ Listo';
        setTimeout(function(){btn.classList.remove('mdl-done');span.textContent=orig;},2000);
      });
    });
  })();
  </script>
</BaseLayout>

