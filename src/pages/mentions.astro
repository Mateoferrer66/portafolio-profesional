<BaseLayout
  title="Menciones & Certificaciones | Mateo Ferrer — +163 Diplomas Verificados"
  description="Más de 163 certificados y diplomas verificados de Platzi, IBM y más en desarrollo web, software, IA, diseño y marketing. Descarga cada diploma directamente."
  keywords="certificados mateo ferrer, diplomas platzi, IBM design thinking, react certificado, scrum master diploma, javascript, portfolio certificaciones colombia"
>
  <!-- HERO -->
  <section class="mhero">
    <div class="mhero-glow"></div>
    <div class="mhero-particles" id="mhero-particles"></div>
    <div class="mhero-content">
      <div class="mhero-badge">
        <span class="mbadge-dot"></span>
        <span>Verificado &amp; Autenticado</span>
      </div>
      <h1 class="mhero-title">
        <span class="mhighlight">Menciones</span> &amp; <span class="mhighlight">Certificaciones</span>
      </h1>
      <p class="mhero-sub">
        Más de <strong id="mcert-counter">0</strong> diplomas y certificaciones verificadas
        en tecnología, diseño y negocios digitales.
      </p>
      <div class="mhero-stats">
        <div class="mstat-pill"><span class="mstat-num">163</span><span class="mstat-label">Certificados</span></div>
        <div class="mstat-pill"><span class="mstat-num">3</span><span class="mstat-label">Instituciones</span></div>
        <div class="mstat-pill"><span class="mstat-num">12</span><span class="mstat-label">Áreas</span></div>
      </div>
    </div>
  </section>

  <!-- ═══ ACTA UNIVERSITARIA — TARJETA DESTACADA ═══════════════════════════ -->
  <section class="mfeatured-wrap wrapper">
    <div class="mfeatured-label">
      <span class="mfeatured-star">★</span>
      <span>Credencial Principal</span>
    </div>
    <div class="mfeatured-card">
      <!-- Glow orbs -->
      <div class="mfc-orb mfc-orb1"></div>
      <div class="mfc-orb mfc-orb2"></div>
      <!-- Left: icon + title -->
      <div class="mfc-left">
        <div class="mfc-icon-ring">
          <span class="mfc-icon">🎓</span>
        </div>
        <div class="mfc-meta">
          <span class="mfc-badge">🏛️ Educación Superior Oficial</span>
          <h2 class="mfc-title">Acta de Grado Universitario</h2>
          <p class="mfc-desc">
            Documento oficial que certifica la culminación de estudios universitarios,
            emitido por institución de educación superior reconocida. Credencial de
            mayor jerarquía académica en el perfil profesional.
          </p>
          <div class="mfc-tags">
            <span class="mfc-tag">📜 Grado Universitario</span>
            <span class="mfc-tag">✅ Documento Oficial</span>
            <span class="mfc-tag">🇨🇴 Colombia</span>
          </div>
        </div>
      </div>
      <!-- Right: actions -->
      <div class="mfc-right">
        <a
