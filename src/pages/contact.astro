---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import Icon from "../components/Icon.astro";
---

<BaseLayout
  title="Contacto | Mateo Ferrer — Desarrollador Web"
  description="Ponte en contacto con Mateo Ferrer para cotizar tu proyecto web, desarrollo de software o consultoría tecnológica."
  keywords="contacto mateo ferrer, cotizar proyecto web, desarrollo web colombia, freelance developer"
>
  <div class="stack gap-20">
    <main class="wrapper contact-page">
      <Hero
        title="Contacto"
        tagline="¿Tienes un proyecto en mente? Hablemos y hagámoslo realidad."
      />

      <div class="contact-grid">
        <!-- Contact Form -->
        <div class="contact-form-card glass-card reveal">
          <form id="contact-form" class="contact-form" action="https://formspree.io/f/placeholder" method="POST">
            <div class="form-group">
              <label for="name" class="form-label">Nombre Completo</label>
              <div class="input-wrapper">
                <span class="input-icon">👤</span>
                <input 
                  type="text" 
                  id="name" 
                  name="name" 
                  required 
                  placeholder="Tu nombre"
                  class="form-input"
                  autocomplete="name"
                />
              </div>
              <span class="form-error" id="name-error"></span>
            </div>

            <div class="form-group">
              <label for="email" class="form-label">Email</label>
              <div class="input-wrapper">
                <span class="input-icon">📧</span>
                <input 
                  type="email" 
                  id="email" 
                  name="email" 
                  required 
                  placeholder="tu@email.com"
                  class="form-input"
                  autocomplete="email"
                />
              </div>
              <span class="form-error" id="email-error"></span>
            </div>

            <div class="form-group">
              <label for="project-type" class="form-label">Tipo de Proyecto</label>
              <div class="input-wrapper">
                <span class="input-icon">🚀</span>
                <select id="project-type" name="project-type" class="form-input form-select" required>
                  <option value="" disabled selected>Selecciona una opción</option>
                  <option value="web">🌐 Sitio Web / Landing Page</option>
                  <option value="ecommerce">🛒 E-Commerce / Tienda Online</option>
                  <option value="webapp">💻 Aplicación Web</option>
                  <option value="mobile">📱 App Móvil</option>
                  <option value="design">🎨 Diseño UI/UX</option>
                  <option value="consulting">💡 Consultoría Técnica</option>
                  <option value="other">🔧 Otro</option>
                </select>
              </div>
            </div>

            <div class="form-group">
              <label for="budget" class="form-label">
                Presupuesto Estimado: <span id="budget-value" class="budget-value">$1,000 USD</span>
              </label>
              <div class="slider-container">
                <input 
                  type="range" 
                  id="budget" 
                  name="budget" 
                  min="200" 
                  max="10000" 
                  step="100" 
                  value="1000"
                  class="form-slider"
                />
                <div class="slider-labels">
                  <span>$200</span>
                  <span>$10,000+</span>
                </div>
              </div>
            </div>

            <div class="form-group">
              <label for="message" class="form-label">Mensaje</label>
              <div class="input-wrapper textarea-wrapper">
                <span class="input-icon">💬</span>
                <textarea 
                  id="message" 
                  name="message" 
                  required 
                  placeholder="Cuéntame sobre tu proyecto..."
                  class="form-input form-textarea"
                  rows="4"
                ></textarea>
              </div>
              <span class="form-error" id="message-error"></span>
            </div>

            <button type="submit" class="form-submit" id="submit-btn">
              <span class="submit-text">Enviar Mensaje</span>
              <span class="submit-icon">
                <Icon icon="paper-plane-tilt" size="1.2em" />
              </span>
              <div class="submit-loader" style="display:none;">
                <div class="loader-spinner"></div>
              </div>
            </button>
          </form>

          <!-- Success State -->
          <div id="form-success" class="form-success" style="display:none;">
            <div class="success-animation">
              <svg class="checkmark" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 52 52">
                <circle class="checkmark-circle" cx="26" cy="26" r="25" fill="none" />
                <path class="checkmark-check" fill="none" d="M14.1 27.2l7.1 7.2 16.7-16.8" />
              </svg>
            </div>
            <h3>¡Mensaje Enviado! 🎉</h3>
            <p>Te responderé en menos de 24 horas.</p>
            <button class="form-reset-btn" id="form-reset-btn">Enviar otro mensaje</button>
          </div>
        </div>

        <!-- Quick Contact Cards -->
        <div class="quick-contact reveal">
          <h3 class="quick-title">Contacto Directo</h3>
          
          <a href="https://wa.me/573005059987" target="_blank" rel="noopener noreferrer" class="quick-card whatsapp">
            <div class="quick-icon">💬</div>
            <div class="quick-info">
              <span class="quick-label">WhatsApp</span>
              <span class="quick-detail">Respuesta inmediata</span>
            </div>
            <span class="quick-arrow">→</span>
          </a>

          <a href="mailto:mateoferrer66@gmail.com" class="quick-card email-card">
            <div class="quick-icon">📧</div>
            <div class="quick-info">
              <span class="quick-label">Email</span>
              <span class="quick-detail">mateoferrer66@gmail.com</span>
            </div>
            <span class="quick-arrow">→</span>
          </a>

          <a href="https://www.linkedin.com/in/mateo-ferrer-a679a713a/" target="_blank" rel="noopener noreferrer" class="quick-card linkedin-card">
            <div class="quick-icon">💼</div>
            <div class="quick-info">
              <span class="quick-label">LinkedIn</span>
              <span class="quick-detail">Perfil profesional</span>
            </div>
            <span class="quick-arrow">→</span>
          </a>

          <a href="https://github.com/Mateoferrer66" target="_blank" rel="noopener noreferrer" class="quick-card github-card">
            <div class="quick-icon">🐙</div>
            <div class="quick-info">
              <span class="quick-label">GitHub</span>
              <span class="quick-detail">Proyectos open source</span>
            </div>
            <span class="quick-arrow">→</span>
          </a>

          <div class="response-time">
            <span class="response-dot"></span>
            <span>Tiempo de respuesta promedio: <strong>&lt;2 horas</strong></span>
          </div>
        </div>
      </div>
    </main>
  </div>
</BaseLayout>

<script>
  // Budget slider
  const budgetSlider = document.getElementById('budget') as HTMLInputElement;
  const budgetValue = document.getElementById('budget-value');
  if (budgetSlider && budgetValue) {
    budgetSlider.addEventListener('input', () => {
      const val = parseInt(budgetSlider.value);
      budgetValue.textContent = val >= 10000 ? '$10,000+ USD' : `$${val.toLocaleString()} USD`;
    });
  }

  // Real-time validation
  function validateField(input: HTMLInputElement | HTMLTextAreaElement, errorId: string): boolean {
    const errorEl = document.getElementById(errorId);
    if (!input.validity.valid) {
      input.classList.add('invalid');
      input.classList.remove('valid');
      if (errorEl) {
        if (input.validity.valueMissing) errorEl.textContent = 'Este campo es requerido';
        else if (input.validity.typeMismatch) errorEl.textContent = 'Formato inválido';
        else errorEl.textContent = 'Valor inválido';
      }
      return false;
    } else if (input.value.trim()) {
      input.classList.remove('invalid');
      input.classList.add('valid');
      if (errorEl) errorEl.textContent = '';
      return true;
    }
    return true;
  }

  document.querySelectorAll('.form-input').forEach(input => {
    const el = input as HTMLInputElement;
    el.addEventListener('blur', () => validateField(el, el.id + '-error'));
    el.addEventListener('input', () => {
      if (el.classList.contains('invalid')) validateField(el, el.id + '-error');
    });
  });

  // Form submission
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const submitBtn = document.getElementById('submit-btn');
  const formSuccess = document.getElementById('form-success');
  const resetBtn = document.getElementById('form-reset-btn');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    if (!submitBtn || !formSuccess) return;

    // Show loader
    const submitText = submitBtn.querySelector('.submit-text') as HTMLElement;
    const submitIcon = submitBtn.querySelector('.submit-icon') as HTMLElement;
    const submitLoader = submitBtn.querySelector('.submit-loader') as HTMLElement;
    
    if (submitText) submitText.style.display = 'none';
    if (submitIcon) submitIcon.style.display = 'none';
    if (submitLoader) submitLoader.style.display = 'flex';
    (submitBtn as HTMLButtonElement).disabled = true;

    // Simulate form submission (replace with actual formspree/emailjs)
    await new Promise(resolve => setTimeout(resolve, 1500));

    // Show success
    form.style.display = 'none';
    formSuccess.style.display = 'flex';
  });

  resetBtn?.addEventListener('click', () => {
    if (!form || !formSuccess || !submitBtn) return;
    form.reset();
    form.style.display = 'flex';
    formSuccess.style.display = 'none';
    
    const submitText = submitBtn.querySelector('.submit-text') as HTMLElement;
    const submitIcon = submitBtn.querySelector('.submit-icon') as HTMLElement;
    const submitLoader = submitBtn.querySelector('.submit-loader') as HTMLElement;
    
    if (submitText) submitText.style.display = '';
    if (submitIcon) submitIcon.style.display = '';
    if (submitLoader) submitLoader.style.display = 'none';
    (submitBtn as HTMLButtonElement).disabled = false;
  });
</script>

<style>
  .contact-page {
    padding-bottom: 4rem;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 2rem;
    margin-top: 2rem;
  }

  @media (max-width: 768px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }

  /* Glass Card */
  .glass-card {
    background: rgba(15, 12, 30, 0.6);
    border: 1px solid rgba(124, 58, 237, 0.2);
    border-radius: 20px;
    padding: 2rem;
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
  }

  /* Form */
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .form-label {
    font-size: 0.82rem;
    font-weight: 600;
    color: #cbd5e1;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .budget-value {
    color: #a855f7;
    font-weight: 700;
  }

  .input-wrapper {
    position: relative;
    display: flex;
    align-items: center;
  }

  .input-icon {
    position: absolute;
    left: 14px;
    font-size: 1rem;
    z-index: 1;
    pointer-events: none;
  }

  .form-input {
    width: 100%;
    padding: 12px 14px 12px 42px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(124, 58, 237, 0.2);
    border-radius: 12px;
    color: #e2e8f0;
    font-size: 0.9rem;
    font-family: inherit;
    transition: all 0.3s ease;
    outline: none;
  }

  .form-input:focus {
    border-color: #a855f7;
    background: rgba(124, 58, 237, 0.06);
    box-shadow: 0 0 0 3px rgba(124, 58, 237, 0.1);
  }

  .form-input.valid {
    border-color: #4ade80;
  }

  .form-input.invalid {
    border-color: #ef4444;
    animation: inputShake 0.4s ease;
  }

  @keyframes inputShake {
    0%, 100% { transform: translateX(0); }
    25% { transform: translateX(-5px); }
    75% { transform: translateX(5px); }
  }

  .form-input::placeholder {
    color: #475569;
  }

  .form-select {
    cursor: pointer;
    appearance: none;
  }

  .form-textarea {
    resize: vertical;
    min-height: 100px;
  }

  .textarea-wrapper {
    align-items: flex-start;
  }

  .textarea-wrapper .input-icon {
    top: 14px;
  }

  .form-error {
    font-size: 0.72rem;
    color: #ef4444;
    min-height: 1em;
  }

  /* Slider */
  .slider-container {
    padding: 0 4px;
  }

  .form-slider {
    width: 100%;
    height: 6px;
    -webkit-appearance: none;
    appearance: none;
    background: rgba(124, 58, 237, 0.2);
    border-radius: 3px;
    outline: none;
    cursor: pointer;
  }

  .form-slider::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 20px;
    height: 20px;
    background: linear-gradient(135deg, #a855f7, #7c3aed);
    border-radius: 50%;
    cursor: grab;
    box-shadow: 0 0 10px rgba(168, 85, 247, 0.5);
    transition: transform 0.2s;
  }

  .form-slider::-webkit-slider-thumb:active {
    transform: scale(1.2);
    cursor: grabbing;
  }

  .slider-labels {
    display: flex;
    justify-content: space-between;
    font-size: 0.7rem;
    color: #64748b;
    margin-top: 4px;
  }

  /* Submit Button */
  .form-submit {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 14px 28px;
    background: linear-gradient(135deg, #7c3aed, #a855f7);
    border: none;
    border-radius: 12px;
    color: white;
    font-size: 1rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.3s ease;
    font-family: inherit;
    margin-top: 0.5rem;
  }

  .form-submit:hover:not(:disabled) {
    transform: translateY(-2px);
    box-shadow: 0 8px 30px rgba(124, 58, 237, 0.4);
  }

  .form-submit:disabled {
    opacity: 0.7;
    cursor: not-allowed;
  }

  .submit-loader {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .loader-spinner {
    width: 20px;
    height: 20px;
    border: 2px solid rgba(255, 255, 255, 0.3);
    border-top-color: white;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  /* Success */
  .form-success {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 16px;
    padding: 3rem 1rem;
    animation: successFade 0.6s ease;
  }

  @keyframes successFade {
    from { opacity: 0; transform: scale(0.9); }
    to { opacity: 1; transform: scale(1); }
  }

  .success-animation {
    width: 80px;
    height: 80px;
  }

  .checkmark {
    width: 80px;
    height: 80px;
    border-radius: 50%;
  }

  .checkmark-circle {
    stroke-dasharray: 166;
    stroke-dashoffset: 166;
    stroke-width: 2;
    stroke-miterlimit: 10;
    stroke: #4ade80;
    animation: checkStroke 0.6s cubic-bezier(0.65, 0, 0.45, 1) forwards;
  }

  .checkmark-check {
    stroke-dasharray: 48;
    stroke-dashoffset: 48;
    stroke-width: 3;
    stroke-linecap: round;
    stroke: #4ade80;
    animation: checkStroke 0.3s cubic-bezier(0.65, 0, 0.45, 1) 0.6s forwards;
  }

  @keyframes checkStroke {
    100% { stroke-dashoffset: 0; }
  }

  .form-success h3 {
    color: #e2e8f0;
    font-size: 1.3rem;
    margin: 0;
  }

  .form-success p {
    color: #94a3b8;
    margin: 0;
  }

  .form-reset-btn {
    padding: 8px 20px;
    background: rgba(124, 58, 237, 0.15);
    border: 1px solid rgba(124, 58, 237, 0.4);
    border-radius: 10px;
    color: #c4b5fd;
    cursor: pointer;
    font-family: inherit;
    font-weight: 600;
    font-size: 0.85rem;
    transition: all 0.2s;
  }

  .form-reset-btn:hover {
    background: rgba(124, 58, 237, 0.25);
  }

  /* Quick Contact */
  .quick-contact {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .quick-title {
    font-size: 1.1rem;
    color: #e2e8f0;
    margin: 0 0 4px;
  }

  .quick-card {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 18px;
    background: rgba(15, 12, 30, 0.6);
    border: 1px solid rgba(124, 58, 237, 0.15);
    border-radius: 14px;
    text-decoration: none;
    color: inherit;
    transition: all 0.3s ease;
  }

  .quick-card:hover {
    transform: translateX(4px);
    border-color: rgba(124, 58, 237, 0.4);
    background: rgba(124, 58, 237, 0.06);
  }

  .whatsapp:hover { border-color: rgba(37, 211, 102, 0.5); }
  .email-card:hover { border-color: rgba(56, 189, 248, 0.5); }
  .linkedin-card:hover { border-color: rgba(0, 119, 181, 0.5); }
  .github-card:hover { border-color: rgba(255, 255, 255, 0.3); }

  .quick-icon {
    font-size: 1.6rem;
    flex-shrink: 0;
  }

  .quick-info {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .quick-label {
    font-weight: 700;
    color: #e2e8f0;
    font-size: 0.9rem;
  }

  .quick-detail {
    color: #64748b;
    font-size: 0.75rem;
  }

  .quick-arrow {
    color: #64748b;
    font-size: 1.1rem;
    transition: transform 0.2s;
  }

  .quick-card:hover .quick-arrow {
    transform: translateX(4px);
    color: #a855f7;
  }

  .response-time {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 18px;
    background: rgba(74, 222, 128, 0.05);
    border: 1px solid rgba(74, 222, 128, 0.15);
    border-radius: 12px;
    font-size: 0.78rem;
    color: #94a3b8;
    margin-top: 8px;
  }

  .response-dot {
    width: 8px;
    height: 8px;
    background: #4ade80;
    border-radius: 50%;
    flex-shrink: 0;
    animation: availPulse 2s ease-in-out infinite;
  }

  @keyframes availPulse {
    0%, 100% { box-shadow: 0 0 4px rgba(74, 222, 128, 0.4); }
    50% { box-shadow: 0 0 12px rgba(74, 222, 128, 0.8); }
  }
</style>
