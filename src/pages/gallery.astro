---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import Icon from "../components/Icon.astro";
import { getCollection } from "astro:content";

const projects = await getCollection("work");
const allTechs = [...new Set(projects.flatMap(p => p.data.tags || []))].sort();

const liveWebsites = [
  { name: "Coffee Lemon", url: "https://coffee-lemon-seven.vercel.app/", image: "/assets/live/coffee-lemon.jpg", tech: "React" },
  { name: "Esmeralds", url: "https://esmeralds.vercel.app/", image: "/assets/live/esmeralds.jpg", tech: "Next.js" },
  { name: "Impcel", url: "https://impcel.vercel.app/", image: "/assets/live/impcel.jpg", tech: "React" },
  { name: "Juice Khaki", url: "https://juice-khaki.vercel.app/", image: "/assets/live/juice-khaki.jpg", tech: "Vue.js" },
  { name: "PC Master", url: "https://pc-master-chi.vercel.app/", image: "/assets/live/pc-master.jpg", tech: "React" },
  { name: "Radical Customs", url: "https://radical-customs.vercel.app/", image: "/assets/live/radical-customs.jpg", tech: "Next.js" },
  { name: "Restaurants Coral", url: "https://restaurants-coral-two.vercel.app/", image: "/assets/live/restaurants-coral.jpg", tech: "React" },
  { name: "Shoes Ten", url: "https://shoes-ten-orcin.vercel.app/", image: "/assets/live/shoes-ten.jpg", tech: "React" },
  { name: "Catalogo Web", url: "https://catalogo-web-two.vercel.app/", image: "/assets/live/catalogo-web.jpg", tech: "Astro" },
  { name: "MG Sports", url: "https://mg-sports.vercel.app/", image: "/assets/live/mg-sports.jpg", tech: "React" }
];

const allItems = [
  ...projects.map(p => ({
    type: 'project' as const,
    title: p.data.title,
    description: p.data.description,
    image: p.data.img,
    url: `/work/${p.slug}/`,
    tags: p.data.tags || [],
  })),
  ...liveWebsites.map(site => ({
    type: 'live' as const,
    title: site.name,
    description: `Live website — ${site.tech}`,
    image: site.image,
    url: site.url,
    tags: [site.tech],
  }))
];
---

<BaseLayout
  title="Galería | Mateo Ferrer — Portafolio Visual"
  description="Explora todos los proyectos de Mateo Ferrer en una galería visual inmersiva con filtros y lightbox."
  keywords="galería proyectos, portafolio visual, mateo ferrer, showcase desarrollo web"
>
  <div class="stack gap-20">
    <main class="wrapper gallery-page">
      <Hero
        title="Galería"
        tagline="Explora todos mis proyectos en una experiencia visual inmersiva."
      />

      <!-- Filter Bar -->
      <div class="gallery-filters" id="gallery-filters">
        <button class="gal-filter active" data-filter="all">
          <span>🌐</span> Todos ({allItems.length})
        </button>
        <button class="gal-filter" data-filter="project">
          <span>🏗️</span> Proyectos ({projects.length})
        </button>
        <button class="gal-filter" data-filter="live">
          <span>🌍</span> Sitios Live ({liveWebsites.length})
        </button>
      </div>

      <!-- Gallery Grid -->
      <div class="gallery-grid" id="gallery-grid">
        {allItems.map((item, index) => (
          <div 
            class="gal-card reveal"
            data-type={item.type}
            data-tags={item.tags.join(',')}
            style={`animation-delay: ${index * 60}ms`}
          >
            <a 
              href={item.type === 'live' ? item.url : item.url} 
              target={item.type === 'live' ? '_blank' : '_self'}
              rel={item.type === 'live' ? 'noopener noreferrer' : undefined}
              class="gal-link"
            >
              <div class="gal-image-wrapper">
                <img 
                  src={item.image} 
                  alt={item.title} 
                  loading="lazy" 
                  class="gal-image"
                  onerror="this.style.display='none'"
                />
                <div class="gal-overlay">
                  <div class="gal-overlay-content">
                    <span class="gal-type-badge">{item.type === 'live' ? '🌍 Live Site' : '🏗️ Project'}</span>
                    <h3 class="gal-title">{item.title}</h3>
                    <p class="gal-desc">{item.description}</p>
                    <div class="gal-tags">
                      {item.tags.slice(0, 3).map(tag => (
                        <span class="gal-tag">{tag}</span>
                      ))}
                    </div>
                    <span class="gal-view-btn">
                      {item.type === 'live' ? 'Visitar Sitio →' : 'Ver Detalle →'}
                    </span>
                  </div>
                </div>
              </div>
            </a>
          </div>
        ))}
      </div>
    </main>
  </div>
</BaseLayout>

<script>
  // Masonry-like stagger animation
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        (entry.target as HTMLElement).classList.add('gal-visible');
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.1, rootMargin: '50px' });

  document.querySelectorAll('.gal-card').forEach(card => observer.observe(card));

  // Filter logic
  document.querySelectorAll('.gal-filter').forEach(btn => {
    btn.addEventListener('click', () => {
      const filter = (btn as HTMLElement).dataset.filter;
      
      document.querySelectorAll('.gal-filter').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      document.querySelectorAll('.gal-card').forEach((card, index) => {
        const cardEl = card as HTMLElement;
        const type = cardEl.dataset.type;
        const show = filter === 'all' || type === filter;
        
        if (show) {
          cardEl.style.display = '';
          cardEl.style.animationDelay = (index * 40) + 'ms';
          cardEl.classList.remove('gal-visible');
          setTimeout(() => cardEl.classList.add('gal-visible'), 10);
        } else {
          cardEl.style.display = 'none';
        }
      });
    });
  });
</script>

<style>
  .gallery-page {
    padding-bottom: 4rem;
  }

  /* Filters */
  .gallery-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    justify-content: center;
    margin: 2rem 0;
  }

  .gal-filter {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 18px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(124, 58, 237, 0.2);
    border-radius: 999px;
    color: #94a3b8;
    font-size: 0.82rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.25s ease;
    font-family: inherit;
  }

  .gal-filter:hover {
    background: rgba(124, 58, 237, 0.1);
    border-color: rgba(124, 58, 237, 0.5);
    color: #e2e8f0;
  }

  .gal-filter.active {
    background: rgba(124, 58, 237, 0.25);
    border-color: #a855f7;
    color: #e9d5ff;
    box-shadow: 0 0 15px rgba(124, 58, 237, 0.2);
  }

  /* Grid */
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 20px;
  }

  .gal-card {
    opacity: 0;
    transform: translateY(30px) scale(0.96);
    transition: opacity 0.5s ease, transform 0.5s ease;
  }

  .gal-card.gal-visible {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  .gal-link {
    display: block;
    text-decoration: none;
    color: inherit;
    border-radius: 16px;
    overflow: hidden;
  }

  .gal-image-wrapper {
    position: relative;
    width: 100%;
    height: 240px;
    background: rgba(15, 12, 30, 0.8);
    border: 1px solid rgba(124, 58, 237, 0.15);
    border-radius: 16px;
    overflow: hidden;
    transition: all 0.4s cubic-bezier(0.23, 1, 0.32, 1);
  }

  .gal-card:hover .gal-image-wrapper {
    transform: translateY(-6px);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
    border-color: rgba(124, 58, 237, 0.4);
  }

  .gal-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .gal-card:hover .gal-image {
    transform: scale(1.08);
  }

  /* Overlay */
  .gal-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(5, 1, 10, 0.95) 0%, rgba(5, 1, 10, 0.4) 40%, transparent 100%);
    display: flex;
    align-items: flex-end;
    padding: 18px;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .gal-card:hover .gal-overlay {
    opacity: 1;
  }

  .gal-overlay-content {
    width: 100%;
  }

  .gal-type-badge {
    display: inline-block;
    padding: 2px 8px;
    background: rgba(124, 58, 237, 0.3);
    border-radius: 6px;
    font-size: 0.65rem;
    font-weight: 700;
    color: #c4b5fd;
    margin-bottom: 6px;
  }

  .gal-title {
    margin: 0;
    font-size: 1.1rem;
    font-weight: 700;
    color: #e2e8f0;
  }

  .gal-desc {
    margin: 4px 0 8px;
    font-size: 0.75rem;
    color: #94a3b8;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .gal-tags {
    display: flex;
    gap: 4px;
    flex-wrap: wrap;
    margin-bottom: 8px;
  }

  .gal-tag {
    padding: 2px 8px;
    background: rgba(74, 222, 128, 0.1);
    border: 1px solid rgba(74, 222, 128, 0.2);
    border-radius: 6px;
    font-size: 0.65rem;
    color: #4ade80;
    font-weight: 600;
  }

  .gal-view-btn {
    font-size: 0.78rem;
    color: #a855f7;
    font-weight: 700;
    transition: color 0.2s;
  }

  .gal-card:hover .gal-view-btn {
    color: #c4b5fd;
  }

  @media (max-width: 640px) {
    .gallery-grid {
      grid-template-columns: 1fr;
    }
    .gal-image-wrapper {
      height: 200px;
    }
  }
</style>
