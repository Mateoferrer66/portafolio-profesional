---
import { getCollection } from "astro:content";

import BaseLayout from "../layouts/BaseLayout.astro";

import ContactCTA from "../components/ContactCTA.astro";
import PortfolioPreview from "../components/PortfolioPreview.astro";
import Hero from "../components/Hero.astro";
import Grid from "../components/Grid.astro";

const allProjects = (await getCollection("work")).sort(
	(a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);

// Group projects by category
const courseProjects = allProjects.filter((p) => p.data.category === "courses");
const personalProjects = allProjects.filter(
	(p) => p.data.category === "personal",
);
const clientProjects = allProjects.filter(
	(p) => p.data.category === "client-work",
);

const allTags = allProjects.flatMap((p) => p.data.tags || []);
const tagCounts = allTags.reduce(
	(acc, tag) => {
		acc[tag] = (acc[tag] || 0) + 1;
		return acc;
	},
	{} as Record<string, number>,
);
const topTags = Object.keys(tagCounts)
	.sort((a, b) => {
		const diff = tagCounts[b] - tagCounts[a];
		if (diff !== 0) return diff;
		return a.localeCompare(b);
	})
	.slice(0, 10);

const liveWebsites = [
	{ name: "Coffee Lemon", url: "https://coffee-lemon-seven.vercel.app/", image: "/assets/live/coffee-lemon.jpg" },
	{ name: "Esmeralds", url: "https://esmeralds.vercel.app/", image: "/assets/live/esmeralds.jpg" },
	{ name: "Impcel", url: "https://impcel.vercel.app/", image: "/assets/live/impcel.jpg" },
	{ name: "Juice Khaki", url: "https://juice-khaki.vercel.app/", image: "/assets/live/juice-khaki.jpg" },
	{ name: "PC Master", url: "https://pc-master-chi.vercel.app/", image: "/assets/live/pc-master.jpg" },
	{ name: "Radical Customs", url: "https://radical-customs.vercel.app/", image: "/assets/live/radical-customs.jpg" },
	{ name: "Restaurants Coral", url: "https://restaurants-coral-two.vercel.app/", image: "/assets/live/restaurants-coral.jpg" },
	{ name: "Shoes Ten", url: "https://shoes-ten-orcin.vercel.app/", image: "/assets/live/shoes-ten.jpg" },
	{ name: "Catalogo Web", url: "https://catalogo-web-two.vercel.app/", image: "/assets/live/catalogo-web.jpg" },
	{ name: "MG Sports", url: "https://mg-sports.vercel.app/", image: "/assets/live/mg-sports.jpg" }
];
---

<BaseLayout
	title="My Work | Mateo Ferrer"
	description="Explore my portfolio of professional projects, courses, and personal work"
>
	<div class="stack gap-20">
		<main class="wrapper stack gap-8">
			<Hero
				title="My Work"
				tagline="Explore my comprehensive portfolio of client projects, educational courses, and personal initiatives."
				align="start"
			/>

			<!-- Search Bar -->
			<div class="search-container">
				<input
					type="text"
					id="work-search"
					placeholder="Search projects..."
				/>
				<svg
					xmlns="http://www.w3.org/2000/svg"
					width="20"
					height="20"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					class="search-icon"
				>
					<circle cx="11" cy="11" r="8"></circle>
					<line x1="21" y1="21" x2="16.65" y2="16.65"></line>
				</svg>
			</div>

			<!-- Filter Tags -->
			<div class="filter-container">
				<button class="filter-tag active" data-tag="all">All</button>
				{
					topTags.map((tag) => (
						<button class="filter-tag" data-tag={tag}>
							{tag}
						</button>
					))
				}
			</div>

			<!-- Cursos de React Section -->
			<section class="category-section courses-section" id="cursos-section">
				<header class="section-header">
					<h2 class="section-title">
						<span class="icon">📚</span> Cursos
					</h2>
					<p class="section-description">
						Formación integral práctica en desarrollo web y React. Accede a las clases completas y proyectos reales.
					</p>
				</header>
				<div class="courses-featured-container">
					<a href="/work/cursos-react" class="course-featured-card" data-tags="React,JavaScript,Education,Frontend">
						<div class="course-image-wrap">
							<img
								src="https://images.unsplash.com/photo-1633356122544-f134324a6cee?w=1200&h=600&fit=crop&q=80"
								alt="Cursos de React - 20 Videos"
								loading="lazy"
							/>
							<div class="course-play-overlay">
								<div class="play-button-glow">
									<svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
								</div>
								<span class="video-count-badge">▶ 20 Videos Disponibles</span>
							</div>
						</div>
						<div class="course-info-wrap">
							<div class="course-tags">
								<span class="course-tag">React</span>
								<span class="course-tag">JavaScript</span>
								<span class="course-tag">Frontend</span>
								<span class="course-tag badge-youtube">YouTube</span>
							</div>
							<h3 class="course-card-title">Cursos de React — Desde Cero a Avanzado</h3>
							<p class="course-card-desc">
								Aprende componentes, props, hooks modernos (useState, useEffect, useReducer), Context API, React Router, TypeScript y construcción de proyectos reales paso a paso.
							</p>
							<div class="course-action-row">
								<span class="view-course-btn">
									Ver las 20 Clases del Curso
									<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
								</span>
							</div>
						</div>
					</a>
				</div>
			</section>

			<!-- Personal Projects Section -->
			{
				personalProjects.length > 0 && (
					<section class="category-section">
						<header class="section-header">
							<h2 class="section-title">
								<span class="icon">🚀</span> Personal Projects
							</h2>
							<p class="section-description">
								Innovative personal initiatives including
								Freelance work, MilMexico, and Tradership.
							</p>
						</header>
						<Grid variant="offset">
							{personalProjects.map((project) => (
								<li class="project-item">
									<PortfolioPreview project={project} />
								</li>
							))}
						</Grid>
					</section>
				)
			}

			<!-- Client Work Section -->
			{
				clientProjects.length > 0 && (
					<section class="category-section">
						<header class="section-header">
							<h2 class="section-title">
								<span class="icon">💼</span> Client Projects
							</h2>
							<p class="section-description">
								Professional work delivered for clients,
								showcasing real-world solutions.
							</p>
						</header>
						<Grid variant="offset">
							{clientProjects.map((project) => (
								<li class="project-item">
									<PortfolioPreview project={project} />
								</li>
							))}
						</Grid>
					</section>
				)
			}
		<!-- Live Web Projects Section -->
			<section class="category-section">
				<header class="section-header">
					<h2 class="section-title">
						<span class="icon">🌍</span> Live Web Experiences
					</h2>
					<p class="section-description">
						Una colección de aplicaciones web y plataformas e-commerce reales diseñadas y desarrolladas para impacto en el mundo real.
					</p>
				</header>

				<div class="gallery" style="margin-top: 2rem;">
					<Grid variant="small">
						{
							liveWebsites.map((site) => (
								<li class="web-card tilt-card" style="list-style: none;">
									<a
										href={site.url}
										target="_blank"
										rel="noopener noreferrer"
										class="web-link"
									>
										<div class="web-image">
											<div class="browser-header">
												<span class="dot red"></span>
												<span class="dot yellow"></span>
												<span class="dot green"></span>
											</div>
											<img
												src={site.image}
												alt={`Screenshot of ${site.name}`}
												loading="lazy"
											/>
										</div>
										<div class="web-info">
											<h3>{site.name}</h3>
											<p class="web-url">{site.url.replace('https://', '').replace(/\/$/, '')}</p>
											<span class="visit-btn">Visitar Sitio <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg></span>
										</div>
									</a>
								</li>
							))
						}
					</Grid>
				</div>
			</section>

		</main>
		<ContactCTA />
	</div>
</BaseLayout>

<script>
	const filterTags = document.querySelectorAll(".filter-tag");
	const projectItems = document.querySelectorAll(".project-item");
	const sections = document.querySelectorAll(".category-section");
	const searchInput = document.getElementById(
		"work-search",
	) as HTMLInputElement;

	function filterProjects() {
		const activeTagBtn = document.querySelector(".filter-tag.active");
		const activeTag = activeTagBtn
			? activeTagBtn.getAttribute("data-tag")
			: "all";
		const searchTerm = searchInput ? searchInput.value.toLowerCase() : "";

		// Show/Hide projects
		projectItems.forEach((item) => {
			const card = item.querySelector(".card");
			const title =
				card?.querySelector(".title")?.textContent?.toLowerCase() || "";
			const projectTags =
				card?.getAttribute("data-tags")?.split(",") || [];

			const matchTag =
				activeTag === "all" || projectTags.includes(activeTag || "");
			const matchSearch = title.includes(searchTerm);

			if (matchTag && matchSearch) {
				(item as HTMLElement).style.display = "block";
			} else {
				(item as HTMLElement).style.display = "none";
			}
		});

		// Show/Hide course featured card
		const courseCards = document.querySelectorAll(".course-featured-card");
		courseCards.forEach((card) => {
			const title = card.querySelector(".course-card-title")?.textContent?.toLowerCase() || "";
			const projectTags = card.getAttribute("data-tags")?.split(",") || [];
			const matchTag = activeTag === "all" || projectTags.includes(activeTag || "");
			const matchSearch = title.includes(searchTerm);
			const container = card.closest(".courses-featured-container") as HTMLElement;
			if (container) {
				container.style.display = (matchTag && matchSearch) ? "block" : "none";
			}
		});

		// Hide empty sections
		sections.forEach((section) => {
			const visibleItems = section.querySelectorAll(
				'.project-item:not([style*="display: none"]), .courses-featured-container:not([style*="display: none"])',
			);
			if (visibleItems.length === 0) {
				(section as HTMLElement).style.display = "none";
			} else {
				(section as HTMLElement).style.display = "block";
			}
		});
	}

	filterTags.forEach((btn) => {
		btn.addEventListener("click", () => {
			filterTags.forEach((b) => b.classList.toggle("active", b === btn));
			filterProjects();
		});
	});

	searchInput?.addEventListener("input", filterProjects);
</script>

<style>
	.project-item {
		width: 100%;
		display: block;
	}

	/* Featured Course Section */
	.courses-featured-container {
		width: 100%;
		max-width: 900px;
		margin: 0 auto;
	}

	.course-featured-card {
		display: grid;
		grid-template-columns: 1fr;
		background: rgba(15, 10, 30, 0.8);
		border: 1px solid rgba(124, 58, 237, 0.35);
		border-radius: 1.5rem;
		overflow: hidden;
		text-decoration: none;
		color: inherit;
		transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
		box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5), 0 0 20px rgba(124, 58, 237, 0.15);
	}

	@media (min-width: 50em) {
		.course-featured-card {
			grid-template-columns: 1.1fr 1fr;
		}
	}

	.course-featured-card:hover {
		transform: translateY(-6px);
		border-color: rgba(124, 58, 237, 0.7);
		box-shadow: 0 20px 50px rgba(0, 0, 0, 0.7), 0 0 35px rgba(124, 58, 237, 0.35);
	}

	.course-image-wrap {
		position: relative;
		min-height: 240px;
		overflow: hidden;
	}

	.course-image-wrap img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.6s ease;
	}

	.course-featured-card:hover .course-image-wrap img {
		transform: scale(1.05);
	}

	.course-play-overlay {
		position: absolute;
		inset: 0;
		background: linear-gradient(to top, rgba(10, 5, 25, 0.9) 0%, rgba(10, 5, 25, 0.3) 100%);
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 12px;
	}

	.play-button-glow {
		width: 64px;
		height: 64px;
		border-radius: 50%;
		background: #ff0000;
		color: #ffffff;
		display: flex;
		align-items: center;
		justify-content: center;
		box-shadow: 0 0 25px rgba(255, 0, 0, 0.7);
		transition: transform 0.3s ease, box-shadow 0.3s ease;
	}

	.course-featured-card:hover .play-button-glow {
		transform: scale(1.12);
		box-shadow: 0 0 35px rgba(255, 0, 0, 0.9);
	}

	.play-button-glow svg {
		margin-left: 4px;
	}

	.video-count-badge {
		font-size: 0.8rem;
		font-weight: 700;
		letter-spacing: 0.05em;
		background: rgba(0, 0, 0, 0.75);
		border: 1px solid rgba(255, 255, 255, 0.2);
		padding: 4px 12px;
		border-radius: 20px;
		color: #ffffff;
		backdrop-filter: blur(8px);
	}

	.course-info-wrap {
		padding: 2rem;
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 1rem;
	}

	.course-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.course-tag {
		font-size: 0.75rem;
		font-weight: 600;
		padding: 3px 10px;
		border-radius: 99px;
		background: rgba(124, 58, 237, 0.25);
		color: #c4b5fd;
		border: 1px solid rgba(124, 58, 237, 0.4);
	}

	.course-tag.badge-youtube {
		background: rgba(255, 0, 0, 0.2);
		color: #ff8080;
		border-color: rgba(255, 0, 0, 0.4);
	}

	.course-card-title {
		font-size: var(--text-2xl);
		color: var(--gray-0);
		font-weight: 700;
		line-height: 1.25;
	}

	.course-card-desc {
		font-size: var(--text-sm);
		color: var(--gray-300);
		line-height: 1.6;
	}

	.course-action-row {
		margin-top: 0.5rem;
	}

	.view-course-btn {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		font-weight: 600;
		font-size: var(--text-sm);
		color: #ffffff;
		background: linear-gradient(135deg, #7c3aed 0%, #a855f7 100%);
		padding: 10px 20px;
		border-radius: 50px;
		transition: all 0.3s ease;
		box-shadow: 0 4px 15px rgba(124, 58, 237, 0.4);
	}

	.course-featured-card:hover .view-course-btn {
		transform: translateX(4px);
		box-shadow: 0 6px 20px rgba(124, 58, 237, 0.6);
	}

	.category-section {
		margin-bottom: 4rem;
		padding: 2rem 0;
		border-bottom: 1px solid var(--gray-800);
	}

	.category-section:last-of-type {
		border-bottom: none;
	}

	.section-header {
		margin-bottom: 2rem;
		text-align: center;
	}

	.section-title {
		font-size: var(--text-3xl);
		font-weight: 700;
		color: var(--gray-0);
		margin-bottom: 0.75rem;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.75rem;
	}

	.icon {
		font-size: 1.5em;
	}

	.section-description {
		font-size: var(--text-lg);
		color: var(--gray-0);
		max-width: 50ch;
		margin: 0 auto;
		line-height: 1.6;
	}

	@media (min-width: 50em) {
		.category-section {
			padding: 3rem 0;
		}

		.section-title {
			font-size: var(--text-4xl);
		}

		.section-header {
			margin-bottom: 3rem;
		}
	}

	.search-container {
		position: relative;
		max-width: 400px;
		margin: 0 auto 1.5rem auto;
	}

	.search-container input {
		width: 100%;
		padding: 0.75rem 1rem 0.75rem 2.5rem;
		border-radius: 9999px;
		border: 1px solid var(--gray-800);
		background: var(--surface-2);
		color: var(--gray-200);
		font-size: var(--text-base);
		transition: all 0.2s ease;
	}

	.search-container input:focus {
		outline: none;
		border-color: var(--accent-regular);
		box-shadow: 0 0 0 2px var(--accent-regular);
	}

	.search-icon {
		position: absolute;
		left: 1rem;
		top: 50%;
		transform: translateY(-50%);
		color: var(--gray-400);
		pointer-events: none;
	}

	.filter-container {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		justify-content: center;
		margin-bottom: 2rem;
	}

	.filter-tag {
		background: var(--surface-2);
		color: var(--text-main);
		border: 1px solid var(--gray-800);
		padding: 0.5rem 1rem;
		border-radius: 9999px;
		cursor: pointer;
		transition: all 0.2s ease;
		font-size: var(--text-sm);
	}

	.filter-tag:hover,
	.filter-tag.active {
		background: var(--accent-regular);
		color: white;
		border-color: var(--accent-regular);
	}

	.web-card {
		border-radius: 1.5rem;
		background: rgba(var(--gray-999-basis), 0.7);
		border: 1px solid var(--gray-800);
		overflow: hidden;
		transition: all 0.5s cubic-bezier(0.23, 1, 0.32, 1);
		box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
		position: relative;
	}

	.web-card::after {
		content: '';
		position: absolute;
		top: -2px; left: -2px; right: -2px; bottom: -2px;
		background: linear-gradient(45deg, var(--accent-regular), transparent, var(--accent-dark));
		z-index: -1;
		border-radius: 1.6rem;
		opacity: 0;
		transition: opacity 0.5s ease;
	}

	.web-card:hover {
		transform: translateY(-12px) scale(1.03);
		box-shadow: 0 30px 60px rgba(0, 0, 0, 0.6);
		border-color: transparent;
	}

	.web-card:hover::after {
		opacity: 1;
	}

	.web-link {
		text-decoration: none;
		color: inherit;
		display: flex;
		flex-direction: column;
		height: 100%;
	}

	.web-image {
		position: relative;
		width: 100%;
		height: 250px;
		background: #000;
		border-bottom: 1px solid var(--gray-800);
		overflow: hidden;
	}

	.web-image::before {
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(to top, rgba(0,0,0,0.8) 0%, transparent 50%);
		z-index: 1;
		opacity: 0.6;
		transition: opacity 0.5s ease;
	}

	.web-card:hover .web-image::before {
		opacity: 0;
	}

	.browser-header {
		display: flex;
		gap: 6px;
		padding: 10px 12px;
		background: rgba(20, 20, 20, 0.8);
		backdrop-filter: blur(10px);
		border-bottom: 1px solid rgba(255, 255, 255, 0.05);
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		z-index: 2;
	}

	.dot {
		width: 10px;
		height: 10px;
		border-radius: 50%;
	}
	.dot.red { background: #ff5f56; }
	.dot.yellow { background: #ffbd2e; }
	.dot.green { background: #27c93f; }

	.web-image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: top;
		padding-top: 30px;
		transition: transform 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94), filter 0.5s ease;
		filter: brightness(0.85);
	}

	.web-card:hover .web-image img {
		transform: scale(1.08);
		filter: brightness(1.1);
	}

	.web-info {
		padding: 1.5rem;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		flex-grow: 1;
		background: rgba(var(--gray-999-basis), 0.5);
		backdrop-filter: blur(5px);
	}

	.web-info h3 {
		font-size: 1.25rem;
		margin: 0;
		color: var(--gray-100);
	}

	.web-url {
		font-size: 0.875rem;
		color: var(--accent-regular);
		margin: 0;
		opacity: 0.8;
	}

	.visit-btn {
		margin-top: auto;
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.875rem;
		font-weight: 600;
		color: var(--gray-300);
		transition: color 0.2s ease;
		padding-top: 1rem;
	}

	.web-card:hover .visit-btn {
		color: var(--accent-text-over);
	}
</style>
