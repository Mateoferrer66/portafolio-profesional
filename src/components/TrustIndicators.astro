---
// TrustIndicators.astro
// Premium trust band with animated indicators to build instant credibility
// Placed right after the hero to establish confidence before scrolling
---

<section class="trust-section reveal">
  <div class="trust-band">
    <div class="trust-item">
      <div class="trust-icon">🛡️</div>
      <div class="trust-text">
        <strong>Garantía de Satisfacción</strong>
        <span>O te devuelvo tu dinero</span>
      </div>
    </div>
    <div class="trust-divider"></div>
    <div class="trust-item">
      <div class="trust-icon">⚡</div>
      <div class="trust-text">
        <strong>Entrega en 2-4 Semanas</strong>
        <span>Cumplimiento garantizado</span>
      </div>
    </div>
    <div class="trust-divider"></div>
    <div class="trust-item">
      <div class="trust-icon">💬</div>
      <div class="trust-text">
        <strong>Soporte Directo WhatsApp</strong>
        <span>Respuesta en menos de 2 horas</span>
      </div>
    </div>
    <div class="trust-divider"></div>
    <div class="trust-item">
      <div class="trust-icon">📊</div>
      <div class="trust-text">
        <strong>Resultados Medibles</strong>
        <span>Métricas reales verificables</span>
      </div>
    </div>
    <div class="trust-divider"></div>
    <div class="trust-item">
      <div class="trust-icon">🏆</div>
      <div class="trust-text">
        <strong>+220 Certificaciones</strong>
        <span>Platzi, Google, IBM & más</span>
      </div>
    </div>
  </div>
</section>

<style>
  .trust-section {
    width: 100%;
    padding: 0 1rem;
  }

  .trust-band {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    padding: 1.75rem 2.5rem;
    background: linear-gradient(
      135deg,
      rgba(124, 58, 237, 0.08) 0%,
      rgba(6, 182, 212, 0.06) 50%,
      rgba(124, 58, 237, 0.04) 100%
    );
    border: 1px solid rgba(124, 58, 237, 0.15);
    border-radius: 1.5rem;
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    max-width: 1200px;
    margin: 0 auto;
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
    position: relative;
  }

  .trust-band::-webkit-scrollbar {
    display: none;
  }

  .trust-band::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 10%;
    right: 10%;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(124, 58, 237, 0.4), transparent);
  }

  .trust-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-shrink: 0;
    transition: transform 0.3s ease;
  }

  .trust-item:hover {
    transform: translateY(-2px);
  }

  .trust-icon {
    font-size: 1.75rem;
    line-height: 1;
    animation: trust-pulse 3s ease-in-out infinite;
  }

  .trust-item:nth-child(1) .trust-icon { animation-delay: 0s; }
  .trust-item:nth-child(3) .trust-icon { animation-delay: 0.5s; }
  .trust-item:nth-child(5) .trust-icon { animation-delay: 1s; }
  .trust-item:nth-child(7) .trust-icon { animation-delay: 1.5s; }
  .trust-item:nth-child(9) .trust-icon { animation-delay: 2s; }

  @keyframes trust-pulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.15); }
  }

  .trust-text {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .trust-text strong {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--gray-0);
    white-space: nowrap;
  }

  .trust-text span {
    font-size: 0.72rem;
    color: var(--gray-400);
    white-space: nowrap;
  }

  .trust-divider {
    width: 1px;
    height: 36px;
    background: linear-gradient(to bottom, transparent, rgba(124, 58, 237, 0.3), transparent);
    flex-shrink: 0;
  }

  @media (max-width: 900px) {
    .trust-band {
      padding: 1.25rem 1.5rem;
      gap: 1rem;
      justify-content: flex-start;
    }

    .trust-divider {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .trust-band {
      padding: 1rem;
      gap: 1.5rem;
      border-radius: 1rem;
    }

    .trust-icon {
      font-size: 1.5rem;
    }

    .trust-text strong {
      font-size: 0.78rem;
    }
  }
</style>
