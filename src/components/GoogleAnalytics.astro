---
// GoogleAnalytics.astro
// Universal Google Analytics 4 (gtag.js) setup with automatic Astro ViewTransitions support
---

<!-- Google tag (gtag.js) -->
<script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-HD5XWZYCZQ"></script>
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  window.gtag = function() {
    window.dataLayer.push(arguments);
  };

  window.gtag('js', new Date());
  window.gtag('config', 'G-HD5XWZYCZQ', {
    send_page_view: true,
    cookie_flags: 'SameSite=None;Secure'
  });

  // Track client-side page views on Astro ViewTransitions navigation
  document.addEventListener('astro:page-load', function() {
    var path = window.location.pathname + window.location.search;
    var title = document.title;
    var loc = window.location.href;

    if (typeof window.gtag === 'function') {
      window.gtag('event', 'page_view', {
        page_title: title,
        page_location: loc,
        page_path: path
      });
    }

    if (Array.isArray(window.dataLayer)) {
      window.dataLayer.push({
        event: 'page_view',
        page_title: title,
        page_location: loc,
        page_path: path
      });
    }
  });
</script>
