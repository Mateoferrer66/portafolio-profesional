---
// GlobalControls.astro
// Este componente se carga en BaseLayout con transition:persist
// Contiene la UI global de la IA (Cámara, Micrófono y Cursor Virtual) y toda la lógica.
// Funciona en TODAS las páginas gracias a astro:page-load re-binding.
---

<div id="global-ai-controls" data-astro-transition-persist="global-ai" style="position:fixed;z-index:12000;inset:0;pointer-events:none;">
  <!-- Botón Global Flotante para encender/apagar IA -->
  <button id="global-ai-btn" type="button" title="Activar IA (Gestos y Voz)" style="pointer-events:auto;position:fixed;bottom:20px;left:20px;background:rgba(15,15,20,0.85);border:2px solid rgba(124,58,237,0.6);border-radius:50px;padding:10px 18px;display:flex;align-items:center;gap:8px;cursor:pointer;z-index:12001;backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);transition:all 0.3s ease;color:#e2e8f0;font-family:inherit;font-size:0.85rem;font-weight:600;box-shadow:0 4px 20px rgba(124,58,237,0.3);">
    <span style="font-size:1.3rem;">🤖</span>
    <span id="ai-btn-text" style="color:#e2e8f0;">IA Apagada</span>
  </button>

  <!-- Contenedor de la Webcam y Canvas de Gestos (Oculto por defecto) -->
  <div id="global-webcam-container" style="display:none;position:fixed;bottom:80px;left:20px;width:240px;height:180px;border-radius:16px;overflow:hidden;border:2px solid rgba(124,58,237,0.5);box-shadow:0 8px 32px rgba(0,0,0,0.6);z-index:12001;pointer-events:auto;background:#000;">
    <video id="global-webcam-feed" autoplay playsinline muted style="width:100%;height:100%;object-fit:cover;transform:scaleX(-1);"></video>
    <canvas id="global-webcam-canvas" style="position:absolute;top:0;left:0;width:100%;height:100%;transform:scaleX(-1);"></canvas>
    
    <div id="voice-status" style="position:absolute;bottom:8px;left:50%;transform:translateX(-50%);background:rgba(0,0,0,0.7);backdrop-filter:blur(8px);padding:4px 12px;border-radius:20px;display:flex;align-items:center;gap:6px;white-space:nowrap;">
      <span style="font-size:0.9rem;">🎙️</span>
      <span id="voice-text" style="font-size:0.7rem;color:#4ade80;">Escuchando comandos...</span>
    </div>
  </div>

  <!-- Virtual Cursor Global -->
  <div id="global-virtual-cursor" style="position:fixed;pointer-events:none;z-index:20000;transform:translate(-50%,-50%);display:none;">
    <div style="width:40px;height:40px;border:2px solid #D4AF37;border-radius:50%;animation:cursorPulse 1.5s ease-in-out infinite;"></div>
    <div style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:8px;height:8px;background:#D4AF37;border-radius:50%;box-shadow:0 0 10px #D4AF37;"></div>
  </div>
  
  <!-- Hidden link for bypass popup blocker navigation -->
  <a id="global-gesture-nav-link" href="#" target="_blank" rel="noopener noreferrer" style="position:absolute;width:1px;height:1px;opacity:0;pointer-events:none;overflow:hidden;z-index:-1;"></a>

  <!-- Toast Notificaciones IA (Voice / Gestures) -->
  <div id="ai-toast" style="display:none;position:fixed;top:20px;left:50%;transform:translateX(-50%);background:rgba(15,15,20,0.9);border:1px solid rgba(124,58,237,0.5);border-radius:12px;padding:10px 20px;z-index:20001;pointer-events:none;backdrop-filter:blur(12px);color:#e2e8f0;font-size:0.85rem;display:flex;align-items:center;gap:8px;">
    <span id="ai-toast-icon">ℹ️</span>
    <span id="ai-toast-msg">Mensaje</span>
  </div>
</div>

<style is:global>
  /* ── Contenedor Principal ── */
  .global-ai-container {
    position: fixed;
    z-index: 12000; /* Siempre encima de todo */
    pointer-events: none; /* Dejar pasar clicks por defecto */
    inset: 0;
  }

  /* ── Botón Flotante Activar IA ── */
  .ai-toggle-btn {
    pointer-events: auto;
    position: absolute;
    bottom: 20px;
    left: 20px;
    background: rgba(15, 15, 20, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.15);
    padding: 10px 18px;
    border-radius: 30px;
    display: flex;
    align-items: center;
    gap: 8px;
    color: #fff;
    font-weight: 500;
    font-size: 0.95rem;
    cursor: pointer;
    backdrop-filter: blur(10px);
    transition: all 0.3s ease;
    box-shadow: 0 4px 15px rgba(0,0,0,0.4);
  }
  .ai-toggle-btn:hover {
    background: rgba(25, 25, 30, 0.95);
    border-color: var(--accent-regular, #D4AF37);
    transform: translateY(-2px);
  }
  .ai-toggle-btn.active {
    background: rgba(212, 175, 55, 0.15);
    border-color: #D4AF37;
    box-shadow: 0 0 15px rgba(212, 175, 55, 0.3);
  }

  /* ── Webcam Box ── */
  .webcam-box {
    position: absolute;
    bottom: 70px;
    left: 20px;
    width: 240px;
    height: 180px;
    background: #000;
    border-radius: 12px;
    overflow: hidden;
    border: 2px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 10px 30px rgba(0,0,0,0.5);
    transition: all 0.3s ease;
  }
  .webcam-box.hidden {
    opacity: 0;
    pointer-events: none;
    transform: translateY(20px) scale(0.95);
  }
  .webcam-box video, .webcam-box canvas {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scaleX(-1); /* Espejo */
  }
  .webcam-box canvas {
    z-index: 2;
  }
  
  .voice-status {
    position: absolute;
    bottom: 8px;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(0,0,0,0.7);
    padding: 4px 10px;
    border-radius: 20px;
    font-size: 0.75rem;
    color: #fff;
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 6px;
    white-space: nowrap;
    border: 1px solid rgba(212, 175, 55, 0.3);
  }

  /* ── Virtual Cursor ── */
  .virtual-cursor {
    position: fixed;
    width: 40px;
    height: 40px;
    pointer-events: none;
    z-index: 20000;
    transform: translate(-50%, -50%);
    display: none; /* Oculto hasta que detecta mano */
  }
  .cursor-dot {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 8px;
    height: 8px;
    background: #D4AF37; /* Dorado */
    border-radius: 50%;
    transform: translate(-50%, -50%);
    box-shadow: 0 0 10px #D4AF37;
    transition: transform 0.1s;
  }
  .cursor-ring {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: 2px solid rgba(212, 175, 55, 0.5);
    border-radius: 50%;
    animation: cursorBreathing 2s infinite ease-in-out;
  }
  .virtual-cursor.clicking .cursor-ring {
    background: rgba(212, 175, 55, 0.3);
    transform: scale(0.6);
    animation: none;
  }
  .virtual-cursor.clicking .cursor-dot {
    transform: translate(-50%, -50%) scale(1.5);
  }

  @keyframes cursorBreathing {
    0% { transform: scale(0.8); opacity: 0.5; }
    50% { transform: scale(1.1); opacity: 1; }
    100% { transform: scale(0.8); opacity: 0.5; }
  }

  /* ── Toast de Feedback IA ── */
  .ai-toast {
    position: absolute;
    top: 20px;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(15, 15, 20, 0.9);
    border: 1px solid #D4AF37;
    padding: 12px 24px;
    border-radius: 30px;
    color: #fff;
    font-weight: 500;
    display: flex;
    align-items: center;
    gap: 10px;
    box-shadow: 0 10px 25px rgba(0,0,0,0.5);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    z-index: 15000;
  }
  .ai-toast.hidden {
    opacity: 0;
    transform: translate(-50%, -20px);
    pointer-events: none;
  }

  :global(.click-ripple) {
    position: fixed;
    width: 20px;
    height: 20px;
    border: 2px solid #D4AF37;
    border-radius: 50%;
    transform: translate(-50%, -50%);
    animation: rippleAnim 0.6s ease-out forwards;
    pointer-events: none;
    z-index: 19999;
  }
  @keyframes rippleAnim {
    0% { width: 20px; height: 20px; opacity: 1; }
    100% { width: 80px; height: 80px; opacity: 0; }
  }
</style>

<!-- Script global de IA que maneja Gestos y Voz -->
<!-- Nota: Usamos is:inline para evitar que Astro lo reinicie al hacer ViewTransitions. El componente persistirá. -->
<script is:inline src="https://cdn.jsdelivr.net/npm/@mediapipe/camera_utils@0.3.1640029074/camera_utils.js" crossorigin="anonymous"></script>
<script is:inline src="https://cdn.jsdelivr.net/npm/@mediapipe/hands@0.4.1646424915/hands.js" crossorigin="anonymous"></script>

<script is:inline>
(function() {
  'use strict';
  
  // ═══════════════════════════════════════════════════════════════
  //  STATE (persists across ViewTransitions navigation)
  // ═══════════════════════════════════════════════════════════════
  if (!window._globalAIState) {
    window._globalAIState = {
      cameraActive: false,
      handsInstance: null,
      stream: null,
      cursorX: 0,
      cursorY: 0,
      pinchCooldown: false,
      scrollCooldown: false,
      recognition: null,
      isListening: false,
      toastTimer: null,
    };
  }
  var state = window._globalAIState;

  // ═══════════════════════════════════════════════════════════════
  //  DOM BINDING — Runs on every page load / navigation
  // ═══════════════════════════════════════════════════════════════
  function bindDOM() {
    var aiBtn = document.getElementById('global-ai-btn');
    var aiBtnText = document.getElementById('ai-btn-text');
    var webcamBox = document.getElementById('global-webcam-container');
    var videoElement = document.getElementById('global-webcam-feed');
    var canvasElement = document.getElementById('global-webcam-canvas');
    var virtualCursor = document.getElementById('global-virtual-cursor');
    var aiToast = document.getElementById('ai-toast');
    var aiToastIcon = document.getElementById('ai-toast-icon');
    var aiToastMsg = document.getElementById('ai-toast-msg');
    var voiceStatusText = document.getElementById('voice-text');

    if (!aiBtn || !canvasElement) return; // safety

    var canvasCtx = canvasElement.getContext('2d');

    // Update UI to reflect current state
    if (state.cameraActive) {
      aiBtnText.textContent = 'IA Encendida';
      aiBtn.style.borderColor = '#4ade80';
      aiBtn.style.boxShadow = '0 4px 20px rgba(74,222,128,0.4)';
      webcamBox.style.display = 'block';
    } else {
      aiBtnText.textContent = 'IA Apagada';
      aiBtn.style.borderColor = 'rgba(124,58,237,0.6)';
      aiBtn.style.boxShadow = '0 4px 20px rgba(124,58,237,0.3)';
      webcamBox.style.display = 'none';
      if (virtualCursor) virtualCursor.style.display = 'none';
    }

    // Re-attach video stream if camera is active
    if (state.cameraActive && state.stream && videoElement) {
      videoElement.srcObject = state.stream;
      videoElement.play().catch(function(){});
      canvasElement.width = videoElement.videoWidth || 320;
      canvasElement.height = videoElement.videoHeight || 240;
    }

    // ═══════════════════════════════════════════════════════════════
    //  VOICE COMMANDS — Navigation + Scroll + Control
    // ═══════════════════════════════════════════════════════════════
    var voiceCommands = {
      // Navigation
      'inicio': '/',
      'hogar': '/',
      'home': '/',
      'acerca': '/about',
      'sobre mi': '/about',
      'sobre mí': '/about',
      'trabajo': '/work',
      'proyectos': '/work',
      'servicios': '/services',
      'tienda': '/shop',
      'comercio': '/shop',
      'gesto': '/gesture-video',
      'gestos': '/gesture-video',
      'video': '/gesture-video',
      'contacto': '#contact',
    };

    // Scroll commands (not navigation)
    var scrollCommands = {
      'subir': -300,
      'sube': -300,
      'arriba': -300,
      'bajar': 300,
      'baja': 300,
      'abajo': 300,
      'scroll up': -300,
      'scroll down': 300,
    };

    // Control commands
    var controlCommands = ['detener', 'parar', 'stop', 'apagar'];

    // ═══════════════════════════════════════════════════════════════
    //  BUTTON HANDLER
    // ═══════════════════════════════════════════════════════════════
    
    // Remove previous listener to avoid duplicates
    var newBtn = aiBtn.cloneNode(true);
    aiBtn.parentNode.replaceChild(newBtn, aiBtn);
    aiBtn = newBtn;
    aiBtnText = aiBtn.querySelector('#ai-btn-text') || aiBtn.querySelector('span:last-child');

    aiBtn.addEventListener('click', function() {
      if (state.cameraActive) {
        stopAI();
      } else {
        startAI();
      }
    });

    // ═══════════════════════════════════════════════════════════════
    //  TOAST
    // ═══════════════════════════════════════════════════════════════
    function showToast(msg, icon, duration) {
      icon = icon || 'ℹ️';
      duration = duration || 3000;
      var toastEl = document.getElementById('ai-toast');
      var toastIconEl = document.getElementById('ai-toast-icon');
      var toastMsgEl = document.getElementById('ai-toast-msg');
      if (!toastEl || !toastMsgEl) return;
      
      toastMsgEl.textContent = msg;
      if (toastIconEl) toastIconEl.textContent = icon;
      toastEl.style.display = 'flex';
      
      if (state.toastTimer) clearTimeout(state.toastTimer);
      state.toastTimer = setTimeout(function() {
        toastEl.style.display = 'none';
      }, duration);
    }

    // ═══════════════════════════════════════════════════════════════
    //  START AI
    // ═══════════════════════════════════════════════════════════════
    async function startAI() {
      aiBtnText.textContent = 'Iniciando IA...';
      aiBtn.style.borderColor = '#4ade80';
      aiBtn.style.boxShadow = '0 4px 20px rgba(74,222,128,0.4)';
      
      try {
        // 1. Start Voice Control
        initVoiceControl();
        
        // 2. Start Camera for Gestures
        state.stream = await navigator.mediaDevices.getUserMedia({ video: { width: 320, height: 240 } });
        var vid = document.getElementById('global-webcam-feed');
        if (vid) {
          vid.srcObject = state.stream;
          vid.play().catch(function(e) { console.error("Error playing video:", e); });
          
          vid.onloadedmetadata = function() {
            var cvs = document.getElementById('global-webcam-canvas');
            if (cvs) {
              cvs.width = vid.videoWidth;
              cvs.height = vid.videoHeight;
            }
            
            initMediaPipe();
            var wb = document.getElementById('global-webcam-container');
            if (wb) wb.style.display = 'block';
            state.cameraActive = true;
            aiBtnText.textContent = 'IA Encendida';
            showToast('Gestos y Voz Activados ✅', '🟢');
            
            // Render loop
            function renderLoop() {
              if (state.cameraActive) {
                var v = document.getElementById('global-webcam-feed');
                if (state.handsInstance && v && v.readyState >= 2) {
                  state.handsInstance.send({image: v}).catch(function(err) {
                    console.error("Error sending frame to MediaPipe:", err);
                  });
                }
                requestAnimationFrame(renderLoop);
              }
            }
            renderLoop();
          };
        }
      } catch (err) {
        console.error(err);
        aiBtnText.textContent = 'IA Apagada';
        aiBtn.style.borderColor = 'rgba(124,58,237,0.6)';
        aiBtn.style.boxShadow = '0 4px 20px rgba(124,58,237,0.3)';
        showToast('Error de permisos. Permite cámara y micrófono.', '❌', 5000);
      }
    }

    // ═══════════════════════════════════════════════════════════════
    //  STOP AI
    // ═══════════════════════════════════════════════════════════════
    function stopAI() {
      state.cameraActive = false;
      
      // Stop Camera
      if (state.stream) {
        state.stream.getTracks().forEach(function(track) { track.stop(); });
        state.stream = null;
      }
      var wb = document.getElementById('global-webcam-container');
      if (wb) wb.style.display = 'none';
      var vc = document.getElementById('global-virtual-cursor');
      if (vc) vc.style.display = 'none';
      
      // Stop Voice
      if (state.recognition && state.isListening) {
        try { state.recognition.stop(); } catch(e){}
        state.isListening = false;
      }
      
      // Reset hands instance so it re-creates on next start
      state.handsInstance = null;
      
      aiBtnText.textContent = 'IA Apagada';
      aiBtn.style.borderColor = 'rgba(124,58,237,0.6)';
      aiBtn.style.boxShadow = '0 4px 20px rgba(124,58,237,0.3)';
      showToast('IA Desactivada', '🔴');
    }

    // ═══════════════════════════════════════════════════════════════
    //  VOICE CONTROL
    // ═══════════════════════════════════════════════════════════════
    function initVoiceControl() {
      var SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
      if (!SpeechRecognition) {
        console.warn("Speech API no soportada en este navegador.");
        var vt = document.getElementById('voice-text');
        if (vt) vt.textContent = "🎙️ Voz no soportada";
        return;
      }

      // Re-use existing recognition if still valid
      if (state.recognition && state.isListening) return;

      state.recognition = new SpeechRecognition();
      state.recognition.lang = 'es-ES';
      state.recognition.continuous = true;
      state.recognition.interimResults = false;
      
      state.recognition.onstart = function() {
        state.isListening = true;
        var vt = document.getElementById('voice-text');
        if (vt) vt.textContent = "Escuchando...";
      };

      state.recognition.onresult = function(event) {
        var current = event.resultIndex;
        var transcript = event.results[current][0].transcript.toLowerCase().trim();
        
        console.log("[Voz] Escuché:", transcript);
        
        // Check control commands first
        for (var c = 0; c < controlCommands.length; c++) {
          if (transcript.includes(controlCommands[c])) {
            showToast('Desactivando IA...', '🛑');
            setTimeout(function() { stopAI(); }, 500);
            return;
          }
        }

        // Check scroll commands
        var scrolled = false;
        for (var keyword in scrollCommands) {
          if (transcript.includes(keyword)) {
            scrolled = true;
            window.scrollBy({ top: scrollCommands[keyword], behavior: 'smooth' });
            showToast('Scroll: ' + keyword, '📜', 1500);
            break;
          }
        }
        if (scrolled) return;

        // Check navigation commands
        var foundCommand = false;
        for (var navKey in voiceCommands) {
          if (transcript.includes(navKey) || transcript.includes('ir a ' + navKey) || transcript.includes('entrar a ' + navKey)) {
            foundCommand = true;
            var path = voiceCommands[navKey];
            showToast('Navegando a ' + navKey + '...', '🗣️');
            setTimeout(function() {
              if (path.startsWith('#')) {
                var el = document.querySelector(path);
                if (el) el.scrollIntoView({ behavior: 'smooth' });
              } else {
                window.location.href = path;
              }
            }, 800);
            break;
          }
        }
        
        if (!foundCommand) {
          showToast('Escuché: "' + transcript + '"', '👂', 2000);
        }
      };

      state.recognition.onerror = function(event) {
        console.error("[Voz] Error:", event.error);
        if (event.error === 'not-allowed') {
          showToast("Permiso de micrófono denegado", "🚫");
        }
        // On 'network' error, don't spam the user — just log it
        if (event.error === 'network') {
          console.warn("[Voz] Network error — speech API may not be available.");
        }
      };

      state.recognition.onend = function() {
        if (state.cameraActive) {
          // Restart if it stopped but AI is still active
          try { state.recognition.start(); } catch(e){}
        } else {
          state.isListening = false;
        }
      };

      try {
        state.recognition.start();
      } catch(e) {}
    }

    // ═══════════════════════════════════════════════════════════════
    //  GESTURES (MediaPipe)
    // ═══════════════════════════════════════════════════════════════
    function initMediaPipe() {
      if (typeof Hands === 'undefined') {
        setTimeout(initMediaPipe, 500);
        return;
      }

      if (state.handsInstance) return;

      state.handsInstance = new Hands({locateFile: function(file) {
        return 'https://cdn.jsdelivr.net/npm/@mediapipe/hands@0.4.1646424915/' + file;
      }});
      state.handsInstance.setOptions({
        maxNumHands: 1,
        modelComplexity: 1,
        minDetectionConfidence: 0.65,
        minTrackingConfidence: 0.65
      });

      state.handsInstance.onResults(onHandResults);
    }

    function onHandResults(results) {
      var cvs = document.getElementById('global-webcam-canvas');
      var cursor = document.getElementById('global-virtual-cursor');
      if (!cvs || !cursor) return;
      
      var ctx = cvs.getContext('2d');
      ctx.save();
      ctx.clearRect(0, 0, cvs.width, cvs.height);

      if (results.multiHandLandmarks && results.multiHandLandmarks.length > 0) {
        cursor.style.display = 'block';
        
        var landmarks = results.multiHandLandmarks[0];
        
        // Draw landmarks on canvas for visual feedback
        for (var i = 0; i < landmarks.length; i++) {
          var lx = landmarks[i].x * cvs.width;
          var ly = landmarks[i].y * cvs.height;
          ctx.beginPath();
          ctx.arc(lx, ly, 3, 0, 2 * Math.PI);
          ctx.fillStyle = '#D4AF37';
          ctx.fill();
        }

        var indexTip = landmarks[8];
        
        // Mirror X to match user's real movement
        var normX = 1 - indexTip.x;
        var normY = indexTip.y;

        // Map to viewport
        state.cursorX = normX * window.innerWidth;
        state.cursorY = normY * window.innerHeight;

        // Clamp coordinates
        state.cursorX = Math.max(0, Math.min(window.innerWidth, state.cursorX));
        state.cursorY = Math.max(0, Math.min(window.innerHeight, state.cursorY));

        cursor.style.left = state.cursorX + 'px';
        cursor.style.top = state.cursorY + 'px';

        var gesture = detectGesture(landmarks);
        executeGlobalGesture(gesture, cursor);
      } else {
        cursor.style.display = 'none';
      }
      ctx.restore();
    }

    function detectGesture(landmarks) {
      var thumbTip = landmarks[4];
      var indexTip = landmarks[8];
      var middleTip = landmarks[12];
      var ringTip = landmarks[16];
      var pinkyTip = landmarks[20];
      var thumbIp = landmarks[3];
      var indexPip = landmarks[6];
      var middlePip = landmarks[10];
      var ringPip = landmarks[14];
      var pinkyPip = landmarks[18];
      var wrist = landmarks[0];

      var pinchDist = dist3d(thumbTip, indexTip);
      
      var indexUp = indexTip.y < indexPip.y;
      var middleUp = middleTip.y < middlePip.y;
      var ringUp = ringTip.y < ringPip.y;
      var pinkyUp = pinkyTip.y < pinkyPip.y;
      var thumbUp = Math.abs(thumbTip.x - wrist.x) > Math.abs(thumbIp.x - wrist.x);

      var fingersUp = (indexUp ? 1 : 0) + (middleUp ? 1 : 0) + (ringUp ? 1 : 0) + (pinkyUp ? 1 : 0) + (thumbUp ? 1 : 0);

      if (pinchDist < 0.05) return 'pinch';
      if (indexUp && middleUp && !ringUp && !pinkyUp) return 'peace';
      if (fingersUp >= 4) return 'open';
      if (fingersUp <= 1 && !indexUp) return 'fist';
      if (indexUp && !middleUp && !ringUp && !pinkyUp) return 'point';
      
      return 'none';
    }

    function dist3d(a, b) {
      var dx = a.x - b.x;
      var dy = a.y - b.y;
      var dz = (a.z || 0) - (b.z || 0);
      return Math.sqrt(dx * dx + dy * dy + dz * dz);
    }

    function executeGlobalGesture(gesture, cursor) {
      switch (gesture) {
        case 'pinch':
          if (!state.pinchCooldown) {
            state.pinchCooldown = true;
            if (cursor) cursor.classList.add('clicking');
            setTimeout(function() { if (cursor) cursor.classList.remove('clicking'); }, 300);
            performGlobalClick(state.cursorX, state.cursorY);
            setTimeout(function() { state.pinchCooldown = false; }, 800);
          }
          break;
          
        case 'open':
          // Scroll Up
          if (!state.scrollCooldown) {
            window.scrollBy({ top: -50, behavior: 'auto' });
          }
          break;
          
        case 'fist':
          // Scroll Down
          if (!state.scrollCooldown) {
            window.scrollBy({ top: 50, behavior: 'auto' });
          }
          break;
      }
    }

    function performGlobalClick(x, y) {
      var cursor = document.getElementById('global-virtual-cursor');
      // Hide cursor temporarily to find element beneath
      var prev = '';
      if (cursor) { prev = cursor.style.visibility; cursor.style.visibility = 'hidden'; }
      var el = document.elementFromPoint(x, y);
      if (cursor) cursor.style.visibility = prev;

      if (!el) return;

      createClickRipple(x, y);

      // Click on links
      var link = el.closest('a[href]');
      if (link) {
        if (link.target === '_blank') {
          var newWin = window.open(link.href, '_blank');
          if (!newWin) window.location.href = link.href;
        } else {
          window.location.href = link.href;
        }
        return;
      }

      // Click on buttons
      var button = el.closest('button');
      if (button) {
        button.click();
        return;
      }
      
      // Any other interactive element
      el.click();
    }

    function createClickRipple(x, y) {
      var ripple = document.createElement('div');
      ripple.className = 'click-ripple';
      ripple.style.left = x + 'px';
      ripple.style.top = y + 'px';
      document.body.appendChild(ripple);
      setTimeout(function() { ripple.remove(); }, 600);
    }
  }

  // ═══════════════════════════════════════════════════════════════
  //  INITIALIZATION: Run on first load AND on every page navigation
  // ═══════════════════════════════════════════════════════════════

  // Initial binding
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', bindDOM);
  } else {
    bindDOM();
  }

  // Re-bind on Astro ViewTransitions page swap
  // This fires AFTER the new page's DOM is in place
  document.addEventListener('astro:page-load', function() {
    bindDOM();
  });

  // Also handle astro:after-swap for earlier binding
  document.addEventListener('astro:after-swap', function() {
    // Small delay to ensure DOM is fully updated
    setTimeout(bindDOM, 50);
  });

})();
</script>
