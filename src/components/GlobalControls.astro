---
// GlobalControls.astro
// Voice + Gesture AI controls that persist across page navigations.
// Uses MediaPipe Hands for gesture detection and Web Speech API for voice.
---

<div id="global-ai-controls" transition:persist="global-ai-controls" style="position:fixed;z-index:12000;inset:0;pointer-events:none;">
  <!-- Botón Global Flotante para encender/apagar IA -->
  <button id="global-ai-btn" type="button" title="Activar IA (Gestos y Voz)" style="pointer-events:auto;position:fixed;bottom:20px;left:20px;background:rgba(15,15,20,0.85);border:2px solid rgba(124,58,237,0.6);border-radius:50px;padding:10px 18px;display:flex;align-items:center;gap:8px;cursor:pointer;z-index:12001;backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);transition:all 0.3s ease;color:#e2e8f0;font-family:inherit;font-size:0.85rem;font-weight:600;box-shadow:0 4px 20px rgba(124,58,237,0.3);">
    <span style="font-size:1.3rem;">🤖</span>
    <span id="ai-btn-text" style="color:#e2e8f0;">IA Apagada</span>
  </button>

  <!-- Contenedor de la Webcam y Canvas de Gestos (Oculto por defecto) -->
  <div id="global-webcam-container" style="display:none;position:fixed;bottom:80px;left:20px;width:250px;height:220px;border-radius:16px;overflow:hidden;border:2px solid rgba(124,58,237,0.6);box-shadow:0 8px 32px rgba(0,0,0,0.8);z-index:12001;pointer-events:auto;background:#0d0a1a;flex-direction:column;">
    <!-- Video and canvas frame -->
    <div style="position:relative;width:100%;height:150px;overflow:hidden;background:#000;">
      <video id="global-webcam-feed" autoplay playsinline muted style="width:100%;height:100%;object-fit:cover;transform:scaleX(-1);"></video>
      <canvas id="global-webcam-canvas" style="position:absolute;top:0;left:0;width:100%;height:100%;transform:scaleX(-1);"></canvas>
      
      <!-- Gesture detected badge -->
      <div id="gesture-badge" style="display:none;position:absolute;top:6px;left:6px;background:rgba(0,0,0,0.75);border:1px solid rgba(124,58,237,0.5);color:#c4b5fd;font-size:0.65rem;font-weight:700;padding:2px 8px;border-radius:10px;backdrop-filter:blur(4px);">
        🖐️ Detectando...
      </div>

      <!-- Loading indicator for model -->
      <div id="model-loading" style="display:none;position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);background:rgba(0,0,0,0.85);padding:8px 14px;border-radius:12px;color:#e2e8f0;font-size:0.75rem;text-align:center;white-space:nowrap;">
        <div style="margin-bottom:4px;">⏳</div>
        <span id="model-loading-text">Cargando modelo...</span>
      </div>
    </div>

    <!-- Instructions / status bar -->
    <div style="background:rgba(20,15,35,0.95);padding:6px 10px;display:flex;flex-direction:column;gap:3px;font-size:0.65rem;color:#cbd5e1;border-top:1px solid rgba(124,58,237,0.3);">
      <div id="voice-status" style="display:flex;align-items:center;gap:5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
        <span>🎙️</span>
        <span id="voice-text" style="color:#4ade80;font-weight:600;">Escuchando comandos...</span>
      </div>
      <div style="display:flex;justify-content:space-between;color:#94a3b8;font-size:0.6rem;">
        <span>✋ Abrir: Subir</span>
        <span>✊ Puño: Bajar</span>
        <span>🤏 Clic</span>
      </div>
    </div>
  </div>

  <!-- Virtual Cursor Global -->
  <div id="global-virtual-cursor" style="position:fixed;pointer-events:none;z-index:20000;transform:translate(-50%,-50%);display:none;">
    <div style="width:36px;height:36px;border:2px solid #a855f7;border-radius:50%;animation:cursorPulse 1.5s ease-in-out infinite;box-shadow:0 0 15px rgba(168,85,247,0.6);"></div>
    <div style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:8px;height:8px;background:#4ade80;border-radius:50%;box-shadow:0 0 8px #4ade80;"></div>
  </div>
  
  <!-- Hidden link for seamless ViewTransitions navigation -->
  <a id="global-gesture-nav-link" href="#" style="position:absolute;width:1px;height:1px;opacity:0;pointer-events:none;overflow:hidden;z-index:-1;"></a>

  <!-- Toast Notificaciones IA (Voice / Gestures) -->
  <div id="ai-toast" style="display:none;position:fixed;top:20px;left:50%;transform:translateX(-50%);background:rgba(15,15,25,0.95);border:1px solid rgba(124,58,237,0.6);border-radius:12px;padding:10px 20px;z-index:20001;pointer-events:none;backdrop-filter:blur(12px);color:#e2e8f0;font-size:0.85rem;align-items:center;gap:8px;box-shadow:0 10px 30px rgba(0,0,0,0.6);">
    <span id="ai-toast-icon">ℹ️</span>
    <span id="ai-toast-msg">Mensaje</span>
  </div>
</div>

<style is:global>
  @keyframes cursorPulse {
    0%, 100% { transform: scale(0.85); opacity: 0.6; }
    50% { transform: scale(1.15); opacity: 1; }
  }

  :global(.click-ripple) {
    position: fixed;
    width: 20px;
    height: 20px;
    border: 2px solid #a855f7;
    border-radius: 50%;
    transform: translate(-50%, -50%);
    animation: rippleAnim 0.6s ease-out forwards;
    pointer-events: none;
    z-index: 19999;
  }
  @keyframes rippleAnim {
    0% { width: 20px; height: 20px; opacity: 1; }
    100% { width: 80px; height: 80px; opacity: 0; }
  }
</style>

<!-- MediaPipe scripts — loaded inline to be globally available -->
<script is:inline src="https://cdn.jsdelivr.net/npm/@mediapipe/drawing_utils@0.3.1620248257/drawing_utils.js" crossorigin="anonymous"></script>
<script is:inline src="https://cdn.jsdelivr.net/npm/@mediapipe/hands@0.4.1646424915/hands.js" crossorigin="anonymous"></script>

<script is:inline>
(function() {
  'use strict';

  // ═══════════════════════════════════════════════════════════════
  //  STATE (persists across ViewTransitions and hard page reloads)
  // ═══════════════════════════════════════════════════════════════
  if (!window._globalAIState) {
    window._globalAIState = {
      active: false,
      isStarting: false,
      stream: null,
      handsInstance: null,
      handsReady: false,
      isProcessingFrame: false,
      animFrameId: null,
      recognition: null,
      isListening: false,
      voiceRestartTimer: null,
      lastVoiceActionTime: 0,
      cursorX: window.innerWidth / 2,
      cursorY: window.innerHeight / 2,
      targetCursorX: window.innerWidth / 2,
      targetCursorY: window.innerHeight / 2,
      pinchCooldown: false,
      scrollCooldown: false,
      toastTimer: null,
      lastGesture: 'none',
    };
  }
  var S = window._globalAIState;

  // ═══════════════════════════════════════════════════════════════
  //  TOAST & FEEDBACK
  // ═══════════════════════════════════════════════════════════════
  function showToast(msg, icon, duration) {
    icon = icon || 'ℹ️';
    duration = duration || 3000;
    var t = document.getElementById('ai-toast');
    var ti = document.getElementById('ai-toast-icon');
    var tm = document.getElementById('ai-toast-msg');
    if (!t || !tm) return;
    tm.textContent = msg;
    if (ti) ti.textContent = icon;
    t.style.display = 'flex';
    if (S.toastTimer) clearTimeout(S.toastTimer);
    S.toastTimer = setTimeout(function() {
      if (t) t.style.display = 'none';
    }, duration);
  }

  function setVoiceText(txt) {
    var vt = document.getElementById('voice-text');
    if (vt) vt.textContent = txt;
  }

  function setGestureBadge(txt) {
    var gb = document.getElementById('gesture-badge');
    if (gb) {
      if (txt) {
        gb.textContent = txt;
        gb.style.display = 'block';
      } else {
        gb.style.display = 'none';
      }
    }
  }

  function setLoadingText(txt) {
    var el = document.getElementById('model-loading-text');
    if (el) el.textContent = txt;
  }

  function showLoading(show) {
    var el = document.getElementById('model-loading');
    if (el) el.style.display = show ? 'block' : 'none';
  }

  // ═══════════════════════════════════════════════════════════════
  //  UPDATE UI — syncs DOM buttons and preview with state
  // ═══════════════════════════════════════════════════════════════
  function updateUI() {
    var btn = document.getElementById('global-ai-btn');
    var btnText = document.getElementById('ai-btn-text');
    var webcamBox = document.getElementById('global-webcam-container');
    var cursor = document.getElementById('global-virtual-cursor');
    if (!btn || !btnText) return;

    if (S.active) {
      btnText.textContent = 'IA Encendida';
      btn.style.borderColor = '#4ade80';
      btn.style.boxShadow = '0 4px 20px rgba(74,222,128,0.4)';
      if (webcamBox) {
        webcamBox.style.display = 'flex';
      }
    } else {
      btnText.textContent = 'IA Apagada';
      btn.style.borderColor = 'rgba(124,58,237,0.6)';
      btn.style.boxShadow = '0 4px 20px rgba(124,58,237,0.3)';
      if (webcamBox) {
        webcamBox.style.display = 'none';
      }
      if (cursor) {
        cursor.style.display = 'none';
      }
    }
  }

  // ═══════════════════════════════════════════════════════════════
  //  SMOOTH NAVIGATION (preserves ViewTransitions without reloads)
  // ═══════════════════════════════════════════════════════════════
  function navigateSmooth(url) {
    if (!url) return;
    if (url.startsWith('#')) {
      var el = document.querySelector(url);
      if (el) {
        el.scrollIntoView({ behavior: 'smooth' });
      } else {
        window.location.hash = url;
      }
      return;
    }

    var currentPath = window.location.pathname.replace(/\/$/, '') || '/';
    var targetPath = url.replace(/\/$/, '') || '/';
    if (currentPath === targetPath) {
      showToast('Ya estás en esta página', '📍', 1800);
      return;
    }

    // Trigger Astro ViewTransitions router seamlessly through internal link click
    var navLink = document.getElementById('global-gesture-nav-link');
    if (!navLink) {
      navLink = document.createElement('a');
      navLink.id = 'global-gesture-nav-link';
      navLink.style.display = 'none';
      document.body.appendChild(navLink);
    }
    navLink.removeAttribute('target');
    navLink.href = url;
    navLink.click();
  }

  // ═══════════════════════════════════════════════════════════════
  //  VOICE RECOGNITION (Web Speech API)
  // ═══════════════════════════════════════════════════════════════
  function startVoice() {
    var SR = window.SpeechRecognition || window.webkitSpeechRecognition;
    if (!SR) {
      console.warn('[AI Voice] Web Speech API not supported in this browser.');
      setVoiceText('Voz: usa Chrome o Edge');
      return;
    }

    // Always clean up previous instance first to avoid InvalidStateError
    if (S.recognition) {
      try {
        S.recognition.onstart = null;
        S.recognition.onresult = null;
        S.recognition.onerror = null;
        S.recognition.onend = null;
        S.recognition.abort();
      } catch(e) {}
      S.recognition = null;
    }

    try {
      var rec = new SR();
      rec.lang = 'es-ES';
      rec.continuous = true;
      rec.interimResults = true;
      rec.maxAlternatives = 1;
      S.recognition = rec;

      rec.onstart = function() {
        S.isListening = true;
        setVoiceText('Escuchando comandos...');
        console.log('[AI Voice] Recognition active.');
      };

      rec.onresult = function(event) {
        if (!event.results || event.results.length === 0) return;
        
        var latestResult = event.results[event.results.length - 1];
        var transcript = latestResult[0].transcript.toLowerCase().trim();
        var isFinal = latestResult.isFinal;
        
        setVoiceText('🗣️ "' + transcript + '"');
        processVoiceCommand(transcript, isFinal);
      };

      rec.onerror = function(event) {
        var err = event.error;
        // Silence detection and abort are standard lifecycle events, not real errors
        if (err === 'no-speech' || err === 'aborted') {
          return;
        }
        console.warn('[AI Voice] Recognition event error:', err);

        if (err === 'not-allowed' || err === 'service-not-allowed') {
          S.isListening = false;
          setVoiceText('Micrófono bloqueado 🔒');
          showToast('Permiso de micrófono no otorgado. Habilítalo en el candado 🔒 de tu navegador.', '🎙️', 5000);
          return;
        }
        if (err === 'audio-capture') {
          setVoiceText('Micrófono no detectado');
          showToast('El micrófono está ocupado o desconectado.', '🎙️', 4000);
          return;
        }
        if (err === 'network') {
          setVoiceText('Reconectando voz...');
        }
      };

      rec.onend = function() {
        S.isListening = false;
        // If AI is still active, safely schedule restart with a fresh instance
        if (S.active || localStorage.getItem('portfolio_ai_active') === '1') {
          scheduleVoiceRestart(350);
        }
      };

      rec.start();
    } catch(e) {
      console.warn('[AI Voice] Start exception:', e);
      if (S.active || localStorage.getItem('portfolio_ai_active') === '1') {
        scheduleVoiceRestart(1000);
      }
    }
  }

  function scheduleVoiceRestart(delay) {
    if (S.voiceRestartTimer) clearTimeout(S.voiceRestartTimer);
    S.voiceRestartTimer = setTimeout(function() {
      if ((S.active || localStorage.getItem('portfolio_ai_active') === '1') && !S.isListening) {
        startVoice();
      }
    }, delay || 350);
  }

  function stopVoice() {
    if (S.voiceRestartTimer) {
      clearTimeout(S.voiceRestartTimer);
      S.voiceRestartTimer = null;
    }
    if (S.recognition) {
      try {
        S.recognition.onstart = null;
        S.recognition.onresult = null;
        S.recognition.onerror = null;
        S.recognition.onend = null;
        S.recognition.abort();
      } catch(e) {}
      S.recognition = null;
    }
    S.isListening = false;
  }

  function processVoiceCommand(text, isFinal) {
    var now = Date.now();
    // Debounce commands to avoid repeating during interim results
    if (now - S.lastVoiceActionTime < 1300) return;

    // 1. APAGAR / DETENER IA
    var stopKeywords = ['apagar', 'detener', 'parar', 'desactivar', 'cerrar ia', 'apaga ia', 'stop'];
    for (var s = 0; s < stopKeywords.length; s++) {
      if (text.includes(stopKeywords[s])) {
        S.lastVoiceActionTime = now;
        showToast('Apagando IA...', '🛑', 2000);
        setTimeout(stopAI, 500);
        return;
      }
    }

    // 2. SCROLL ARRIBA / ABAJO
    if (text.includes('subir') || text.includes('sube') || text.includes('arriba') || text.includes('scroll arriba')) {
      S.lastVoiceActionTime = now;
      window.scrollBy({ top: -380, behavior: 'smooth' });
      showToast('Subiendo página', '⬆️', 1500);
      return;
    }
    if (text.includes('bajar') || text.includes('baja') || text.includes('abajo') || text.includes('scroll abajo')) {
      S.lastVoiceActionTime = now;
      window.scrollBy({ top: 380, behavior: 'smooth' });
      showToast('Bajando página', '⬇️', 1500);
      return;
    }

    // 3. CAMBIO DE TEMA (CLARO / OSCURO)
    if (text.includes('modo oscuro') || text.includes('modo claro') || text.includes('tema oscuro') || text.includes('tema claro') || text.includes('cambiar tema')) {
      S.lastVoiceActionTime = now;
      var themeBtn = document.querySelector('theme-toggle button');
      if (themeBtn) {
        themeBtn.click();
        showToast('Tema cambiado', '🌓', 1500);
      }
      return;
    }

    // 4. NAVEGACIÓN POR RUTAS
    var navMap = [
      { keys: ['inicio', 'home', 'portada', 'principal'], url: '/' },
      { keys: ['cursos', 'curso', 'react', 'curso react', 'cursos react'], url: '/work/cursos-react' },
      { keys: ['trabajo', 'trabajos', 'proyecto', 'proyectos', 'portafolio'], url: '/work' },
      { keys: ['servicio', 'servicios'], url: '/services' },
      { keys: ['tienda', 'productos', 'shop', 'comprar'], url: '/shop' },
      { keys: ['sobre mi', 'sobre mí', 'acerca', 'perfil', 'biografia', 'biografía'], url: '/about' },
      { keys: ['video', 'gesto', 'gestos', 'interactivo'], url: '/gesture-video' },
      { keys: ['contacto', 'contactar', 'mensaje', 'escribir'], url: '#contact' },
    ];

    for (var n = 0; n < navMap.length; n++) {
      var item = navMap[n];
      for (var k = 0; k < item.keys.length; k++) {
        var keyword = item.keys[k];
        if (text.includes(keyword)) {
          S.lastVoiceActionTime = now;
          showToast('Navegando a ' + keyword + '...', '🚀', 2000);
          setTimeout(function() {
            navigateSmooth(item.url);
          }, 350);
          return;
        }
      }
    }
  }

  // ═══════════════════════════════════════════════════════════════
  //  GESTURES — MediaPipe Hands
  // ═══════════════════════════════════════════════════════════════
  function initHands() {
    if (typeof Hands === 'undefined') {
      console.warn('[AI Gestures] Hands library loading...');
      setLoadingText('Cargando librería...');
      setTimeout(initHands, 400);
      return;
    }

    if (S.handsInstance && S.handsReady) {
      startFrameLoop();
      return;
    }

    showLoading(true);
    setLoadingText('Iniciando IA...');

    try {
      S.handsInstance = new Hands({
        locateFile: function(file) {
          return 'https://cdn.jsdelivr.net/npm/@mediapipe/hands@0.4.1646424915/' + file;
        }
      });

      S.handsInstance.setOptions({
        maxNumHands: 1,
        modelComplexity: 1,
        minDetectionConfidence: 0.5,
        minTrackingConfidence: 0.5
      });

      S.handsInstance.onResults(onHandResults);

      // Warm up model
      var testCanvas = document.createElement('canvas');
      testCanvas.width = 4;
      testCanvas.height = 4;

      S.handsInstance.send({image: testCanvas}).then(function() {
        console.log('[AI Gestures] Model ready!');
        S.handsReady = true;
        showLoading(false);
        startFrameLoop();
      }).catch(function(err) {
        console.warn('[AI Gestures] Warmup skipped, starting live:', err);
        S.handsReady = true;
        showLoading(false);
        startFrameLoop();
      });

    } catch(err) {
      console.error('[AI Gestures] Hands init error:', err);
      showLoading(false);
    }
  }

  function startFrameLoop() {
    if (S.animFrameId) return;

    var vid = document.getElementById('global-webcam-feed');
    var cursor = document.getElementById('global-virtual-cursor');
    if (!vid) return;

    function processFrame() {
      if (!S.active) {
        S.animFrameId = null;
        return;
      }

      // Smooth cursor interpolation
      if (cursor && cursor.style.display !== 'none') {
        S.cursorX += (S.targetCursorX - S.cursorX) * 0.35;
        S.cursorY += (S.targetCursorY - S.cursorY) * 0.35;
        cursor.style.left = S.cursorX + 'px';
        cursor.style.top = S.cursorY + 'px';
      }

      // Send frame to MediaPipe only when previous frame finished
      if (S.handsInstance && S.handsReady && vid.readyState >= 2 && !S.isProcessingFrame) {
        S.isProcessingFrame = true;
        S.handsInstance.send({image: vid})
          .catch(function() {})
          .finally(function() {
            S.isProcessingFrame = false;
          });
      }

      S.animFrameId = requestAnimationFrame(processFrame);
    }

    S.animFrameId = requestAnimationFrame(processFrame);
  }

  function stopFrameLoop() {
    if (S.animFrameId) {
      cancelAnimationFrame(S.animFrameId);
      S.animFrameId = null;
    }
  }

  function onHandResults(results) {
    var cvs = document.getElementById('global-webcam-canvas');
    var cursor = document.getElementById('global-virtual-cursor');
    if (!cvs || !cursor) return;

    var ctx = cvs.getContext('2d');
    ctx.save();
    ctx.clearRect(0, 0, cvs.width, cvs.height);

    if (results.multiHandLandmarks && results.multiHandLandmarks.length > 0) {
      cursor.style.display = 'block';
      var landmarks = results.multiHandLandmarks[0];

      // Draw hand skeleton
      var connections = [
        [0,1],[1,2],[2,3],[3,4],
        [0,5],[5,6],[6,7],[7,8],
        [5,9],[9,10],[10,11],[11,12],
        [9,13],[13,14],[14,15],[15,16],
        [13,17],[17,18],[18,19],[19,20],[0,17]
      ];
      ctx.strokeStyle = 'rgba(168,85,247,0.6)';
      ctx.lineWidth = 2;
      for (var c = 0; c < connections.length; c++) {
        var a = landmarks[connections[c][0]];
        var b = landmarks[connections[c][1]];
        ctx.beginPath();
        ctx.moveTo(a.x * cvs.width, a.y * cvs.height);
        ctx.lineTo(b.x * cvs.width, b.y * cvs.height);
        ctx.stroke();
      }

      // Draw fingertips
      for (var i = 0; i < landmarks.length; i++) {
        var lx = landmarks[i].x * cvs.width;
        var ly = landmarks[i].y * cvs.height;
        ctx.beginPath();
        ctx.arc(lx, ly, i === 8 ? 4 : 2, 0, 2 * Math.PI);
        ctx.fillStyle = i === 8 ? '#4ade80' : '#c4b5fd';
        ctx.fill();
      }

      // Map index fingertip to screen
      var indexTip = landmarks[8];
      var normX = 1 - indexTip.x;
      var normY = indexTip.y;

      S.targetCursorX = Math.max(0, Math.min(window.innerWidth, normX * window.innerWidth));
      S.targetCursorY = Math.max(0, Math.min(window.innerHeight, normY * window.innerHeight));

      var gesture = detectGesture(landmarks);
      executeGesture(gesture, cursor);
    } else {
      cursor.style.display = 'none';
      setGestureBadge(null);
    }
    ctx.restore();
  }

  function dist3d(a, b) {
    var dx = a.x - b.x, dy = a.y - b.y, dz = (a.z||0) - (b.z||0);
    return Math.sqrt(dx*dx + dy*dy + dz*dz);
  }

  function detectGesture(lm) {
    var thumbTip = lm[4], indexTip = lm[8], middleTip = lm[12], ringTip = lm[16], pinkyTip = lm[20];
    var thumbIp = lm[3], indexPip = lm[6], middlePip = lm[10], ringPip = lm[14], pinkyPip = lm[18];
    var wrist = lm[0];

    var pinchDist = dist3d(thumbTip, indexTip);
    var indexUp = indexTip.y < indexPip.y;
    var middleUp = middleTip.y < middlePip.y;
    var ringUp = ringTip.y < ringPip.y;
    var pinkyUp = pinkyTip.y < pinkyPip.y;
    var thumbUp = Math.abs(thumbTip.x - wrist.x) > Math.abs(thumbIp.x - wrist.x);
    var fingersUp = (indexUp?1:0) + (middleUp?1:0) + (ringUp?1:0) + (pinkyUp?1:0) + (thumbUp?1:0);

    if (pinchDist < 0.08) return 'pinch';
    if (fingersUp >= 3) return 'open';
    if (fingersUp <= 1 && !indexUp) return 'fist';
    return 'none';
  }

  function executeGesture(gesture, cursor) {
    switch (gesture) {
      case 'pinch':
        setGestureBadge('🤏 Clic');
        if (!S.pinchCooldown) {
          S.pinchCooldown = true;
          cursor.style.transform = 'translate(-50%, -50%) scale(0.7)';
          setTimeout(function() { cursor.style.transform = 'translate(-50%, -50%)'; }, 250);
          performClick(S.cursorX, S.cursorY);
          setTimeout(function() { S.pinchCooldown = false; }, 600);
        }
        break;

      case 'open':
        setGestureBadge('✋ Subiendo...');
        if (!S.scrollCooldown) {
          S.scrollCooldown = true;
          window.scrollBy({ top: -90, behavior: 'auto' });
          setTimeout(function() { S.scrollCooldown = false; }, 80);
        }
        break;

      case 'fist':
        setGestureBadge('✊ Bajando...');
        if (!S.scrollCooldown) {
          S.scrollCooldown = true;
          window.scrollBy({ top: 90, behavior: 'auto' });
          setTimeout(function() { S.scrollCooldown = false; }, 80);
        }
        break;

      default:
        setGestureBadge('🖐️ Mano activa');
        break;
    }
  }

  function performClick(x, y) {
    var cursor = document.getElementById('global-virtual-cursor');
    var prev = '';
    if (cursor) { prev = cursor.style.visibility; cursor.style.visibility = 'hidden'; }
    var el = document.elementFromPoint(x, y);
    if (cursor) cursor.style.visibility = prev;
    if (!el) return;

    createRipple(x, y);

    var link = el.closest('a[href]');
    if (link) {
      if (link.target === '_blank') {
        window.open(link.href, '_blank');
      } else {
        // Native click triggers ViewTransitions router
        link.click();
      }
      return;
    }

    var button = el.closest('button');
    if (button) {
      button.click();
      return;
    }

    el.click();
  }

  function createRipple(x, y) {
    var r = document.createElement('div');
    r.className = 'click-ripple';
    r.style.left = x + 'px';
    r.style.top = y + 'px';
    document.body.appendChild(r);
    setTimeout(function() { r.remove(); }, 600);
  }

  // ═══════════════════════════════════════════════════════════════
  //  START AI — Main Entry Point
  // ═══════════════════════════════════════════════════════════════
  async function startAI() {
    if (S.isStarting) return;
    S.isStarting = true;

    var btnText = document.getElementById('ai-btn-text');
    if (btnText) btnText.textContent = 'Iniciando...';

    // Persist intent to localStorage: MUST STAY ON UNTIL MANUALLY TURNED OFF!
    localStorage.setItem('portfolio_ai_active', '1');
    S.active = true;

    // Start voice recognition immediately
    startVoice();

    try {
      // Request ONLY video in getUserMedia. SpeechRecognition captures mic independently!
      var stream = S.stream;
      if (!stream || !stream.active) {
        stream = await navigator.mediaDevices.getUserMedia({
          video: { width: { ideal: 320 }, height: { ideal: 240 }, facingMode: 'user' },
          audio: false
        });
        S.stream = stream;
      }

      S.isStarting = false;

      // Attach stream to video element
      var vid = document.getElementById('global-webcam-feed');
      var cvs = document.getElementById('global-webcam-canvas');
      if (vid) {
        vid.srcObject = stream;
        vid.onloadedmetadata = function() {
          vid.play().catch(function(){});
          if (cvs) {
            cvs.width = vid.videoWidth || 320;
            cvs.height = vid.videoHeight || 240;
          }
        };
        vid.play().catch(function(){});
      }

      updateUI();
      showToast('¡IA Activa! Gestos y Voz listos 🖐️🎙️', '✨', 3500);

      // Start gesture detection
      initHands();

    } catch(err) {
      console.warn('[AI] Camera initialization warning:', err);
      S.isStarting = false;

      // Keep active if user still wants it (Voice is already active!)
      if (localStorage.getItem('portfolio_ai_active') === '1') {
        S.active = true;
        updateUI();
        if (err.name === 'NotAllowedError') {
          showToast('Permiso de cámara denegado. Voz activa. Permite cámara para gestos.', '📷', 5000);
        } else if (err.name === 'NotFoundError') {
          showToast('Cámara no detectada. Comandos de voz activos 🎙️', '🎙️', 4000);
        } else {
          showToast('Cámara ocupada. Comandos de voz activos 🎙️', '🎙️', 4000);
        }
      }
    }
  }

  // ═══════════════════════════════════════════════════════════════
  //  STOP AI — ONLY TRIGGERED MANUALLY BY USER
  // ═══════════════════════════════════════════════════════════════
  function stopAI() {
    console.log('[AI] Explicit stop by user.');
    S.active = false;
    S.isStarting = false;

    // The ONLY place where active is set to 0 in localStorage
    localStorage.setItem('portfolio_ai_active', '0');

    // Stop frame loop
    stopFrameLoop();

    // Stop camera tracks
    if (S.stream) {
      S.stream.getTracks().forEach(function(track) { track.stop(); });
      S.stream = null;
    }

    // Clear video element
    var vid = document.getElementById('global-webcam-feed');
    if (vid) vid.srcObject = null;

    // Stop voice
    stopVoice();

    updateUI();
    showToast('IA Desactivada por el usuario', '🔴', 3000);
  }

  // ═══════════════════════════════════════════════════════════════
  //  DOM BINDING & PERSISTENCE (Runs on every page navigation)
  // ═══════════════════════════════════════════════════════════════
  function bindDOM() {
    var aiBtn = document.getElementById('global-ai-btn');
    if (aiBtn && !aiBtn.dataset.bound) {
      aiBtn.dataset.bound = 'true';
      aiBtn.addEventListener('click', function() {
        if (S.active) {
          stopAI();
        } else {
          startAI();
        }
      });
    }

    updateUI();

    // Check if AI should be active based on localStorage
    var shouldBeActive = localStorage.getItem('portfolio_ai_active') === '1';

    if (shouldBeActive) {
      if (!S.active && !S.isStarting) {
        // Auto-resume after hard refresh or first load if was active
        console.log('[AI] Resuming active session from localStorage...');
        startAI();
      } else if (S.active) {
        // Re-attach existing live stream to DOM video if DOM was swapped
        var vid = document.getElementById('global-webcam-feed');
        var cvs = document.getElementById('global-webcam-canvas');
        if (vid && S.stream && vid.srcObject !== S.stream) {
          vid.srcObject = S.stream;
          vid.play().catch(function(){});
          if (cvs) {
            cvs.width = vid.videoWidth || 320;
            cvs.height = vid.videoHeight || 240;
          }
        }
        if (S.handsReady && !S.animFrameId) {
          startFrameLoop();
        }
        if (!S.isListening) {
          startVoice();
        }
      }
    }
  }

  // ═══════════════════════════════════════════════════════════════
  //  LIFECYCLE LISTENERS
  // ═══════════════════════════════════════════════════════════════
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', bindDOM);
  } else {
    bindDOM();
  }

  document.addEventListener('astro:page-load', bindDOM);
  document.addEventListener('astro:after-swap', function() {
    setTimeout(bindDOM, 40);
  });

})();
</script>
