---
// AnalyticsTracker.astro
// Advanced event tracking for clicks, scroll depth, conversions, section impressions, and custom interactions.
// Dispatches seamlessly to both Google Analytics 4 (gtag) and Google Tag Manager (dataLayer).
---

<script is:inline>
(function() {
  'use strict';

  // ── Unified Event Dispatcher (GA4 + GTM) ─────────────────────────
  function sendEvent(eventName, params) {
    params = params || {};
    var timestamp = Date.now();
    var payload = Object.assign({}, params, {
      event_timestamp: timestamp,
      page_location: window.location.pathname
    });

    // 1. Dispatch to Google Analytics (gtag)
    if (typeof window.gtag === 'function') {
      try {
        window.gtag('event', eventName, payload);
      } catch (e) {
        console.warn('[Analytics] GA4 event dispatch error:', e);
      }
    }

    // 2. Dispatch to Google Tag Manager (dataLayer)
    if (Array.isArray(window.dataLayer)) {
      try {
        window.dataLayer.push(Object.assign({ event: eventName }, payload));
      } catch (e) {
        console.warn('[Analytics] GTM dataLayer dispatch error:', e);
      }
    }

    // Debug logging in development / when requested
    if (window.__ANALYTICS_DEBUG__) {
      console.log('[Analytics Event]', eventName, payload);
    }
  }

  // ── 1. CTA & Interactive Element Click Tracking ─────────────────────
  function trackCTAClicks() {
    var ctaSelectors = [
      { selector: '#whatsapp-btn', label: 'WhatsApp Button', category: 'conversion' },
      { selector: 'a[href*="wa.me"]', label: 'WhatsApp Link', category: 'conversion' },
      { selector: '.cta-button.primary', label: 'Primary CTA', category: 'engagement' },
      { selector: '.cta-button.secondary', label: 'Secondary CTA', category: 'engagement' },
      { selector: 'a[download]', label: 'Download CV', category: 'conversion' },
      { selector: 'a[href="/shop/"]', label: 'Visit Shop', category: 'navigation' },
      { selector: 'a[href="/work/"]', label: 'View Work', category: 'navigation' },
      { selector: 'a[href="/contact/"]', label: 'Contact Page', category: 'navigation' },
      { selector: 'a[href="/services/"]', label: 'Services Page', category: 'navigation' },
      { selector: '.product-link', label: 'Product Click', category: 'ecommerce' },
      { selector: '.web-link', label: 'Live Website Click', category: 'portfolio' },
      { selector: '.cert-card', label: 'Certification Click', category: 'engagement' },
      { selector: '.course-card-cta', label: 'Course CTA Click', category: 'conversion' },
      { selector: '.newsletter-submit', label: 'Newsletter Submit', category: 'conversion' },
      { selector: '.estimator-calc-btn', label: 'Estimator Calculated', category: 'lead_generation' },
      { selector: '.estimator-whatsapp-btn', label: 'Estimator WhatsApp Contact', category: 'conversion' },
      { selector: '.project-filter-btn', label: 'Project Filter Selected', category: 'portfolio' },
      { selector: '.sound-toggle-btn', label: 'Sound FX Toggled', category: 'ui_interaction' },
      { selector: '#open-terminal-btn', label: 'Terminal Opened', category: 'engagement' },
      { selector: '#audit-submit-btn', label: 'Run Web Audit', category: 'lead_generation' },
      { selector: '.audit-wa-btn', label: 'Audit WhatsApp Consultation', category: 'conversion' },
      { selector: '.roi-cta-btn', label: 'ROI Simulator Contact', category: 'conversion' }
    ];

    ctaSelectors.forEach(function(item) {
      document.querySelectorAll(item.selector).forEach(function(el) {
        if (el.dataset.tracked) return;
        el.dataset.tracked = 'true';
        el.addEventListener('click', function() {
          sendEvent('cta_click', {
            event_category: item.category,
            event_label: item.label,
            button_text: (el.textContent || item.label).trim().substring(0, 50),
            page_location: window.location.pathname
          });
        });
      });
    });
  }

  // ── 2. Scroll Depth Tracking ───────────────────────────────────────
  function trackScrollDepth() {
    var thresholds = [25, 50, 75, 100];
    var reached = new Set();

    function checkScroll() {
      var winH = window.innerHeight;
      var docH = document.documentElement.scrollHeight;
      var scrolled = window.scrollY;
      var maxScroll = docH - winH;
      if (maxScroll <= 0) return;

      var percent = Math.round((scrolled / maxScroll) * 100);

      thresholds.forEach(function(t) {
        if (percent >= t && !reached.has(t)) {
          reached.add(t);
          sendEvent('scroll_depth', {
            event_category: 'engagement',
            event_label: t + '%',
            value: t,
            page_location: window.location.pathname
          });
        }
      });
    }

    var ticking = false;
    window.addEventListener('scroll', function() {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(function() {
          checkScroll();
          ticking = false;
        });
      }
    }, { passive: true });
  }

  // ── 3. Section Impression Tracking ─────────────────────────────────
  function trackSectionImpressions() {
    var sections = document.querySelectorAll(
      'section[class*="section"], .hero, .stats-section, .services-section, .testimonials-section, .certifications-section, .courses-section, .newsletter-section, .estimator-section, .terminal-section, .audit-section, .roi-section'
    );
    
    if (!sections.length || !('IntersectionObserver' in window)) return;

    var observer = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (!entry.isIntersecting) return;
        var el = entry.target;
        if (el.dataset.impressionSent) return;
        el.dataset.impressionSent = 'true';

        var header = el.querySelector('h2, h3');
        var sectionName = header ? header.textContent.trim() : (el.className.split(' ')[0] || 'unknown');

        sendEvent('section_view', {
          event_category: 'engagement',
          event_label: sectionName,
          page_location: window.location.pathname
        });

        observer.unobserve(el);
      });
    }, { threshold: 0.25 });

    sections.forEach(function(s) { observer.observe(s); });
  }

  // ── 4. Time on Page (Engaged Time) ────────────────────────────────
  function trackEngagedTime() {
    var totalTime = 0;
    var isActive = true;
    var lastTick = Date.now();

    document.addEventListener('visibilitychange', function() {
      if (document.hidden) {
        totalTime += Date.now() - lastTick;
        isActive = false;
      } else {
        lastTick = Date.now();
        isActive = true;
      }
    });

    window.addEventListener('beforeunload', function() {
      if (isActive) {
        totalTime += Date.now() - lastTick;
      }
      var seconds = Math.round(totalTime / 1000);
      if (seconds > 1) {
        sendEvent('engaged_time', {
          event_category: 'engagement',
          event_label: window.location.pathname,
          value: seconds,
          engaged_seconds: seconds
        });
      }
    });
  }

  // ── 5. Outbound Link Tracking ──────────────────────────────────────
  function trackOutboundLinks() {
    document.querySelectorAll('a[target="_blank"]').forEach(function(link) {
      if (link.dataset.outboundTracked) return;
      link.dataset.outboundTracked = 'true';
      link.addEventListener('click', function() {
        sendEvent('outbound_click', {
          event_category: 'outbound',
          event_label: link.href,
          link_url: link.href,
          link_text: (link.textContent || 'Unknown').trim().substring(0, 50)
        });
      });
    });
  }

  // ── 6. Page Performance Tracking ───────────────────────────────────
  function trackPerformance() {
    if (!window.performance || !window.performance.getEntriesByType) return;

    window.addEventListener('load', function() {
      setTimeout(function() {
        var nav = performance.getEntriesByType('navigation')[0];
        if (nav) {
          sendEvent('page_performance', {
            event_category: 'performance',
            dom_load_time: Math.round(nav.domContentLoadedEventEnd - nav.startTime),
            page_load_time: Math.round(nav.loadEventEnd - nav.startTime),
            page_location: window.location.pathname
          });
        }
      }, 2000);
    });
  }

  // ── 7. Developer Analytics Status & Verification Diagnostic Tool ──
  window.__analyticsStatus = function() {
    var ga4Active = typeof window.gtag === 'function';
    var gtmActive = Array.isArray(window.dataLayer) && window.dataLayer.some(function(item) {
      return item && item['gtm.start'];
    });
    var dataLayerCount = Array.isArray(window.dataLayer) ? window.dataLayer.length : 0;
    var lastEvents = Array.isArray(window.dataLayer) ? window.dataLayer.slice(-5) : [];

    console.group('%c📊 [Analytics Diagnostic Status]', 'color:#a855f7;font-weight:bold;font-size:14px;');
    console.log('%cGA4 (gtag.js): %c' + (ga4Active ? '🟢 ACTIVO (G-HD5XWZYCZQ)' : '🔴 INACTIVO'), 'font-weight:bold', ga4Active ? 'color:#10b981' : 'color:#ef4444');
    console.log('%cGTM Container: %c' + (gtmActive ? '🟢 ACTIVO (GTM-58K8HFNK)' : '🔴 NO DETECTADO EN DATALAYER'), 'font-weight:bold', gtmActive ? 'color:#10b981' : 'color:#ef4444');
    console.log('%cTotal eventos en dataLayer: %c' + dataLayerCount, 'font-weight:bold', 'color:#38bdf8');
    console.log('%cÚltimos eventos en dataLayer:', 'font-weight:bold', lastEvents);
    console.log('%cTip: Ejecuta window.__analyticsTestPing() para enviar un evento de prueba en vivo.', 'color:#94a3b8;font-style:italic;');
    console.groupEnd();

    return {
      ga4: ga4Active ? 'Connected (G-HD5XWZYCZQ)' : 'Disconnected',
      gtm: gtmActive ? 'Connected (GTM-58K8HFNK)' : 'Disconnected',
      dataLayerCount: dataLayerCount,
      lastEvents: lastEvents
    };
  };

  window.__analyticsTestPing = function(customLabel) {
    var label = customLabel || 'Manual Test Ping from Console';
    sendEvent('test_ping', {
      event_category: 'diagnostic',
      event_label: label,
      test_timestamp: new Date().toISOString()
    });
    console.log('%c✅ Test ping enviado con éxito a GA4 y GTM dataLayer: "' + label + '"', 'color:#10b981;font-weight:bold;');
    return true;
  };

  // ── Initialize All Trackers ────────────────────────────────────────
  function initAllTrackers() {
    trackCTAClicks();
    trackScrollDepth();
    trackSectionImpressions();
    trackEngagedTime();
    trackOutboundLinks();
    trackPerformance();
  }

  // Run on initial load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAllTrackers);
  } else {
    initAllTrackers();
  }

  // Re-init on Astro page transitions
  document.addEventListener('astro:page-load', function() {
    setTimeout(initAllTrackers, 300);
  });
})();
</script>
