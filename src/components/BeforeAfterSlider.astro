</style>

<script>
  function setupBeforeAfterSliders() {
    // Slider functionality
    const boxes = document.querySelectorAll('[data-slider-box]');
    boxes.forEach(box => {
      const range = box.querySelector('.ba-range') as HTMLInputElement;
      const afterLayer = box.querySelector('.ba-after') as HTMLElement;
      const handle = box.querySelector('.ba-handle') as HTMLElement;

      if (!range || !afterLayer || !handle) return;

      const updateSlider = (val: string) => {
        afterLayer.style.clipPath = `polygon(${val}% 0, 100% 0, 100% 100%, ${val}% 100%)`;
        handle.style.left = `${val}%`;
      };

      range.addEventListener('input', (e) => {
        updateSlider((e.target as HTMLInputElement).value);
      });
    });

    // Tab switching functionality
    const tabs = document.querySelectorAll('.case-tab');
    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        tabs.forEach(t => t.classList.remove('active'));
        tab.classList.add('active');

        const caseId = tab.getAttribute('data-case');
        document.querySelectorAll('.case-content').forEach(content => {
          content.classList.remove('active');
        });

        const activeContent = document.getElementById(`case-${caseId}`);
        if (activeContent) {
          activeContent.classList.add('active');
        }
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupBeforeAfterSliders);
  } else {
    setupBeforeAfterSliders();
  }
</script>
