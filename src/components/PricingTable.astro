---
// PricingTable.astro
// Professional pricing table with 3 plans to drive direct conversions
import Icon from "./Icon.astro";
---

<section id="pricing" class="pricing-section wrapper reveal">
  <div class="pricing-header">
    <div class="pricing-badge">
      <span>💰</span>
      <span>Inversión Transparente</span>
    </div>
    <h2>Planes y Precios</h2>
    <p class="pricing-tagline">Soluciones para cada etapa de tu negocio. Todos incluyen soporte, SEO y optimización de velocidad.</p>

    <div class="currency-toggle">
      <span class="currency-label" data-active="true">USD</span>
      <button id="currency-switch" class="switch-btn" aria-label="Cambiar moneda">
        <span class="switch-dot"></span>
      </button>
      <span class="currency-label">COP</span>
    </div>
  </div>

  <div class="pricing-grid">
    <!-- Plan Starter -->
    <div class="price-card">
      <div class="card-top">
        <span class="plan-icon">🚀</span>
        <h3 class="plan-name">Starter</h3>
        <p class="plan-desc">Ideal para emprendedores y negocios que inician su presencia digital.</p>
      </div>
      <div class="plan-price">
        <span class="price-amount" data-usd="350" data-cop="1,400,000">
          <span class="price-currency">$</span>
          <span class="price-number">350</span>
        </span>
        <span class="price-unit"> <span class="price-curr-label">USD</span> / proyecto</span>
      </div>
      <ul class="plan-features">
        <li class="feat-yes"><span class="feat-check">✓</span> Landing Page / One-page</li>
        <li class="feat-yes"><span class="feat-check">✓</span> Diseño responsive premium</li>
        <li class="feat-yes"><span class="feat-check">✓</span> SEO básico on-page</li>
        <li class="feat-yes"><span class="feat-check">✓</span> Integración WhatsApp</li>
        <li class="feat-yes"><span class="feat-check">✓</span> Hosting 1 año gratis</li>
        <li class="feat-yes"><span class="feat-check">✓</span> Entrega en 7 días</li>
        <li class="feat-no"><span class="feat-cross">✕</span> E-Commerce / Carrito</li>
        <li class="feat-no"><span class="feat-cross">✕</span> Panel de administración</li>
        <li class="feat-no"><span class="feat-cross">✕</span> Automatización Avanzada</li>
      </ul>
      <a
        href="https://wa.me/573005059987?text=Hola%20Mateo%2C%20me%20interesa%20el%20Plan%20Starter%20para%20mi%20negocio.%20%C2%BFPodemos%20hablar%3F"
        target="_blank"
        rel="noopener noreferrer"
        class="plan-cta"
      >
        Comenzar Ahora →
      </a>
    </div>

    <!-- Plan Professional (Recommended) -->
    <div class="price-card featured">
      <div class="popular-badge">⭐ MÁS POPULAR</div>
      <div class="card-top">
        <span class="plan-icon">💎</span>
        <h3 class="plan-name">Professional</h3>
        <p class="plan-desc">La solución completa para negocios que quieren vender en línea y escalar.</p>
      </div>
      <div class="plan-price">
        <span class="price-amount" data-usd="800" data-cop="3,200,000">
          <span class="price-currency">$</span>
          <span class="price-number">800</span>
        </span>
        <span class="price-unit"> <span class="price-curr-label">USD</span> / proyecto</span>
      </div>
      <ul class="plan-features">
        <li class="feat-yes"><span class="feat-check">✓</span> Sitio Web multi-página</li>
        <li class="feat-yes"><span class="feat-check">✓</span> E-Commerce completo</li>
        <li class="feat-yes"><span class="feat-check">✓</span> SEO avanzado + Analytics</li>
        <li class="feat-yes"><span class="feat-check">✓</span> Panel de administración</li>
        <li class="feat-yes"><span class="feat-check">✓</span> Pasarela de pagos</li>
        <li class="feat-yes"><span class="feat-check">✓</span> Chat en vivo integrado</li>
        <li class="feat-yes"><span class="feat-check">✓</span> Hosting 1 año gratis</li>
        <li class="feat-yes"><span class="feat-check">✓</span> Entrega en 15 días</li>
        <li class="feat-no"><span class="feat-cross">✕</span> Automatización Avanzada</li>
      </ul>
      <a
        href="https://wa.me/573005059987?text=Hola%20Mateo%2C%20me%20interesa%20el%20Plan%20Professional%20con%20e-commerce%20para%20mi%20negocio.%20%C2%BFPodemos%20hablar%3F"
        target="_blank"
        rel="noopener noreferrer"
        class="plan-cta plan-cta-featured"
      >
        <Icon icon="rocket-launch" size="1.1em" />
        Elegir Plan Professional
      </a>
    </div>

    <!-- Plan Enterprise -->
    <div class="price-card">
      <div class="card-top">
        <span class="plan-icon">🏢</span>
        <h3 class="plan-name">Enterprise</h3>
        <p class="plan-desc">Para empresas que necesitan soluciones avanzadas y automatización.</p>
      </div>
      <div class="plan-price">
        <span class="price-amount" data-usd="2,000" data-cop="8,000,000">
          <span class="price-currency">$</span>
          <span class="price-number">2,000</span>
        </span>
        <span class="price-unit"> <span class="price-curr-label">USD</span>+ / proyecto</span>
      </div>
      <ul class="plan-features">
        <li class="feat-yes"><span class="feat-check">✓</span> Todo del Plan Professional</li>
        <li class="feat-yes"><span class="feat-check">✓</span> Software a la medida</li>
        <li class="feat-yes"><span class="feat-check">✓</span> Chatbots Inteligentes</li>
        <li class="feat-yes"><span class="feat-check">✓</span> Automatización de procesos</li>
        <li class="feat-yes"><span class="feat-check">✓</span> CRM & Facturación</li>
        <li class="feat-yes"><span class="feat-check">✓</span> Integración con APIs</li>
        <li class="feat-yes"><span class="feat-check">✓</span> Soporte premium 6 meses</li>
        <li class="feat-yes"><span class="feat-check">✓</span> Entrega en 30 días</li>
        <li class="feat-yes"><span class="feat-check">✓</span> Consultoría estratégica</li>
      </ul>
      <a
        href="https://wa.me/573005059987?text=Hola%20Mateo%2C%20me%20interesa%20el%20Plan%20Enterprise%20con%20automatizaci%C3%B3n%20avanzada%20para%20mi%20empresa.%20%C2%BFPodemos%20agendar%20una%20llamada%3F"
        target="_blank"
        rel="noopener noreferrer"
        class="plan-cta"
      >
        Hablar con Mateo →
      </a>
    </div>
  </div>

  <p class="pricing-note">💡 ¿No encaja ningún plan? <a href="https://wa.me/573005059987?text=Hola%20Mateo%2C%20necesito%20una%20cotizaci%C3%B3n%20personalizada%20para%20mi%20proyecto" target="_blank" rel="noopener noreferrer">Cotiza algo 100% personalizado</a></p>
</section>

<script>
  function initPricing() {
    const switchBtn = document.getElementById('currency-switch');
    if (!switchBtn) return;
    let isCOP = false;

    switchBtn.addEventListener('click', () => {
      isCOP = !isCOP;
      switchBtn.classList.toggle('active', isCOP);

      const labels = document.querySelectorAll('.currency-label');
      labels.forEach((l, i) => {
        (l as HTMLElement).dataset.active = String(i === (isCOP ? 1 : 0));
      });

      document.querySelectorAll('.price-amount').forEach(el => {
        const numEl = el.querySelector('.price-number');
        if (!numEl) return;
        const usd = el.getAttribute('data-usd') || '0';
        const cop = el.getAttribute('data-cop') || '0';
        numEl.textContent = isCOP ? cop : usd;
      });

      document.querySelectorAll('.price-curr-label').forEach(el => {
        el.textContent = isCOP ? 'COP' : 'USD';
      });
    });
  }

  document.addEventListener('astro:page-load', initPricing);
</script>

<style>
  .pricing-section {
    padding: 4rem 0;
  }

  .pricing-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .pricing-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 0.4rem 1rem;
    background: linear-gradient(135deg, rgba(245, 158, 11, 0.15), rgba(239, 68, 68, 0.1));
    border: 1px solid rgba(245, 158, 11, 0.25);
    border-radius: 99rem;
    font-size: 0.78rem;
    font-weight: 700;
    color: #fbbf24;
    margin-bottom: 1rem;
  }

  .pricing-header h2 {
    font-size: clamp(1.6rem, 3.5vw, 2.5rem);
    color: var(--gray-0, white);
    margin: 0 0 0.5rem;
  }

  .pricing-tagline {
    color: var(--gray-300, #94a3b8);
    font-size: 1rem;
    max-width: 550px;
    margin: 0 auto 1.5rem;
  }

  .currency-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
  }

  .currency-label {
    font-size: 0.85rem;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.4);
    transition: color 0.3s;
  }

  .currency-label[data-active="true"] {
    color: #a855f7;
  }

  .switch-btn {
    width: 48px;
    height: 26px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(168, 85, 247, 0.3);
    border-radius: 99rem;
    cursor: pointer;
    position: relative;
    transition: all 0.3s;
    padding: 0;
  }

  .switch-dot {
    position: absolute;
    top: 3px;
    left: 3px;
    width: 18px;
    height: 18px;
    background: linear-gradient(135deg, #7c3aed, #a855f7);
    border-radius: 50%;
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .switch-btn.active .switch-dot {
    transform: translateX(22px);
  }

  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    align-items: start;
  }

  .price-card {
    background: rgba(15, 12, 41, 0.6);
    border: 1px solid rgba(168, 85, 247, 0.12);
    border-radius: 24px;
    padding: 2rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    transition: all 0.4s cubic-bezier(0.23, 1, 0.32, 1);
    position: relative;
    overflow: hidden;
  }

  .price-card:hover {
    transform: translateY(-8px);
    border-color: rgba(168, 85, 247, 0.3);
    box-shadow: 0 20px 60px rgba(124, 58, 237, 0.15);
  }

  .price-card.featured {
    border-color: rgba(168, 85, 247, 0.4);
    background: linear-gradient(165deg, rgba(124, 58, 237, 0.12), rgba(15, 12, 41, 0.8));
    box-shadow: 0 0 40px rgba(124, 58, 237, 0.15);
    transform: scale(1.03);
  }

  .price-card.featured:hover {
    transform: scale(1.03) translateY(-8px);
    box-shadow: 0 25px 70px rgba(124, 58, 237, 0.25);
  }

  .price-card.featured::before {
    content: '';
    position: absolute;
    top: -1px;
    left: -1px;
    right: -1px;
    height: 3px;
    background: linear-gradient(90deg, #7c3aed, #a855f7, #d946ef, #a855f7);
    background-size: 200% 100%;
    animation: pricingGlow 3s ease infinite;
    border-radius: 24px 24px 0 0;
  }

  @keyframes pricingGlow {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }

  .popular-badge {
    position: absolute;
    top: 14px;
    right: -28px;
    background: linear-gradient(135deg, #f59e0b, #ef4444);
    color: white;
    padding: 4px 36px;
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 1px;
    transform: rotate(35deg);
    box-shadow: 0 2px 10px rgba(239, 68, 68, 0.3);
  }

  .card-top {
    text-align: center;
  }

  .plan-icon {
    font-size: 2.5rem;
    display: block;
    margin-bottom: 0.5rem;
  }

  .plan-name {
    font-size: 1.4rem;
    color: white;
    margin: 0 0 0.3rem;
  }

  .plan-desc {
    font-size: 0.82rem;
    color: rgba(255, 255, 255, 0.5);
    margin: 0;
    line-height: 1.4;
  }

  .plan-price {
    text-align: center;
    padding: 1rem 0;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .price-amount {
    display: block;
  }

  .price-currency {
    font-size: 1.1rem;
    color: #a855f7;
    font-weight: 700;
    vertical-align: top;
    margin-right: 2px;
  }

  .price-number {
    font-size: 2.5rem;
    font-weight: 800;
    color: white;
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }

  .price-unit {
    display: block;
    font-size: 0.78rem;
    color: rgba(255, 255, 255, 0.4);
    margin-top: 4px;
  }

  .plan-features {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .plan-features li {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.75);
  }

  .feat-check {
    color: #4ade80;
    font-weight: bold;
    font-size: 0.9rem;
    flex-shrink: 0;
  }

  .feat-cross {
    color: rgba(255, 255, 255, 0.2);
    font-weight: bold;
    font-size: 0.9rem;
    flex-shrink: 0;
  }

  .feat-no {
    opacity: 0.45;
  }

  .plan-cta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 0.85rem 1.5rem;
    background: rgba(124, 58, 237, 0.12);
    border: 1px solid rgba(168, 85, 247, 0.3);
    border-radius: 14px;
    color: #c4b5fd;
    font-size: 0.9rem;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.3s;
    margin-top: auto;
  }

  .plan-cta:hover {
    background: rgba(124, 58, 237, 0.2);
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(124, 58, 237, 0.2);
  }

  .plan-cta-featured {
    background: linear-gradient(135deg, #7c3aed, #a855f7);
    border-color: transparent;
    color: white;
  }

  .plan-cta-featured:hover {
    box-shadow: 0 10px 35px rgba(124, 58, 237, 0.5);
    background: linear-gradient(135deg, #6d28d9, #9333ea);
  }

  .pricing-note {
    text-align: center;
    margin-top: 2rem;
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.5);
  }

  .pricing-note a {
    color: #a855f7;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .pricing-note a:hover {
    color: #c4b5fd;
  }

  /* Responsive */
  @media (max-width: 900px) {
    .pricing-grid {
      grid-template-columns: 1fr;
      max-width: 450px;
      margin: 0 auto;
    }

    .price-card.featured {
      transform: none;
      order: -1;
    }

    .price-card.featured:hover {
      transform: translateY(-8px);
    }
  }
</style>
