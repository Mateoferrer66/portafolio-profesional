---
// CaseStudies.astro
// Client Success Stories with animated metrics showing real business impact
import Icon from "./Icon.astro";
---

<section id="case-studies" class="case-studies-section wrapper reveal">
  <div class="cs-header">
    <div class="cs-badge">
      <Icon icon="trophy" size="1.1em" />
      <span>Resultados Comprobados</span>
    </div>
    <h2>Historias de Éxito de Clientes</h2>
    <p class="cs-tagline">Datos reales de proyectos que transformaron negocios con tecnología de alto rendimiento.</p>
  </div>

  <div class="cs-tabs">
    <button class="cs-tab active" data-case="0">Coffee Lemon</button>
    <button class="cs-tab" data-case="1">Radical Customs</button>
    <button class="cs-tab" data-case="2">PC Master</button>
  </div>

  <div class="cs-content">
    <!-- Case 0: Coffee Lemon -->
    <div class="cs-card active" data-case-card="0">
      <div class="cs-card-inner">
        <div class="cs-visual">
          <div class="cs-browser">
            <div class="cs-browser-dots">
              <span class="cdot cred"></span>
              <span class="cdot cyellow"></span>
              <span class="cdot cgreen"></span>
            </div>
            <img src="/assets/live/coffee-lemon.jpg" alt="Coffee Lemon website" loading="lazy" />
          </div>
          <div class="cs-verified">
            <span>✓ Resultado Verificado</span>
          </div>
        </div>
        <div class="cs-details">
          <div class="cs-client-info">
            <h3>Coffee Lemon</h3>
            <span class="cs-type">E-Commerce & Restaurante</span>
          </div>
          <p class="cs-story">
            Transformamos su presencia web obsoleta en un e-commerce moderno con pedidos en línea, menú interactivo y sistema de reservas. La velocidad de carga pasó de 8 segundos a menos de 1 segundo.
          </p>
          <div class="cs-metrics">
            <div class="cs-metric" data-target="150" data-suffix="%">
              <span class="cs-metric-num">0</span><span class="cs-metric-suffix">%</span>
              <span class="cs-metric-label">Aumento en Ventas Online</span>
            </div>
            <div class="cs-metric" data-target="0.8" data-suffix="s" data-decimal="true">
              <span class="cs-metric-num">0</span><span class="cs-metric-suffix">s</span>
              <span class="cs-metric-label">Tiempo de Carga</span>
            </div>
            <div class="cs-metric" data-target="300" data-suffix="%">
              <span class="cs-metric-num">0</span><span class="cs-metric-suffix">%</span>
              <span class="cs-metric-label">Más Tráfico Orgánico</span>
            </div>
          </div>
          <a
            href="https://wa.me/573005059987?text=Hola%20Mateo%2C%20vi%20el%20caso%20de%20%C3%A9xito%20de%20Coffee%20Lemon%20y%20quiero%20resultados%20similares%20para%20mi%20negocio"
            target="_blank"
            rel="noopener noreferrer"
            class="cs-cta"
          >
            <Icon icon="rocket-launch" size="1.1em" />
            Quiero resultados así para mi negocio
          </a>
        </div>
      </div>
    </div>

    <!-- Case 1: Radical Customs -->
    <div class="cs-card" data-case-card="1">
      <div class="cs-card-inner">
        <div class="cs-visual">
          <div class="cs-browser">
            <div class="cs-browser-dots">
              <span class="cdot cred"></span>
              <span class="cdot cyellow"></span>
              <span class="cdot cgreen"></span>
            </div>
            <img src="/assets/live/radical-customs.jpg" alt="Radical Customs website" loading="lazy" />
          </div>
          <div class="cs-verified">
            <span>✓ Resultado Verificado</span>
          </div>
        </div>
        <div class="cs-details">
          <div class="cs-client-info">
            <h3>Radical Customs</h3>
            <span class="cs-type">Tienda Online & Branding</span>
          </div>
          <p class="cs-story">
            Creamos un catálogo online completo con carrito de compras, pasarela de pagos y sistema de gestión de inventario. La marca recibió un rediseño total con identidad visual premium.
          </p>
          <div class="cs-metrics">
            <div class="cs-metric" data-target="200" data-suffix="%">
              <span class="cs-metric-num">0</span><span class="cs-metric-suffix">%</span>
              <span class="cs-metric-label">Crecimiento en Clientes</span>
            </div>
            <div class="cs-metric" data-target="45" data-suffix="%">
              <span class="cs-metric-num">0</span><span class="cs-metric-suffix">%</span>
              <span class="cs-metric-label">Tasa de Conversión</span>
            </div>
            <div class="cs-metric" data-target="500" data-suffix="+">
              <span class="cs-metric-num">0</span><span class="cs-metric-suffix">+</span>
              <span class="cs-metric-label">Productos Catalogados</span>
            </div>
          </div>
          <a
            href="https://wa.me/573005059987?text=Hola%20Mateo%2C%20vi%20el%20caso%20de%20Radical%20Customs%20y%20necesito%20una%20tienda%20online%20para%20mi%20negocio"
            target="_blank"
            rel="noopener noreferrer"
            class="cs-cta"
          >
            <Icon icon="rocket-launch" size="1.1em" />
            Quiero resultados así para mi negocio
          </a>
        </div>
      </div>
    </div>

    <!-- Case 2: PC Master -->
    <div class="cs-card" data-case-card="2">
      <div class="cs-card-inner">
        <div class="cs-visual">
          <div class="cs-browser">
            <div class="cs-browser-dots">
              <span class="cdot cred"></span>
              <span class="cdot cyellow"></span>
              <span class="cdot cgreen"></span>
            </div>
            <img src="/assets/live/pc-master.jpg" alt="PC Master website" loading="lazy" />
          </div>
          <div class="cs-verified">
            <span>✓ Resultado Verificado</span>
          </div>
        </div>
        <div class="cs-details">
          <div class="cs-client-info">
            <h3>PC Master</h3>
            <span class="cs-type">Tecnología & E-Commerce</span>
          </div>
          <p class="cs-story">
            Plataforma e-commerce completa con filtros avanzados, comparador de productos, chat en vivo y sistema de garantías. Integración con múltiples proveedores y gestión automatizada de pedidos.
          </p>
          <div class="cs-metrics">
            <div class="cs-metric" data-target="180" data-suffix="%">
              <span class="cs-metric-num">0</span><span class="cs-metric-suffix">%</span>
              <span class="cs-metric-label">Aumento de Ingresos</span>
            </div>
            <div class="cs-metric" data-target="15" data-suffix="hrs">
              <span class="cs-metric-num">0</span><span class="cs-metric-suffix">hrs</span>
              <span class="cs-metric-label">Ahorradas por Semana</span>
            </div>
            <div class="cs-metric" data-target="98" data-suffix="%">
              <span class="cs-metric-num">0</span><span class="cs-metric-suffix">%</span>
              <span class="cs-metric-label">Satisfacción de Clientes</span>
            </div>
          </div>
          <a
            href="https://wa.me/573005059987?text=Hola%20Mateo%2C%20vi%20el%20caso%20de%20PC%20Master%20y%20quiero%20una%20plataforma%20e-commerce%20as%C3%AD%20para%20mi%20negocio"
            target="_blank"
            rel="noopener noreferrer"
            class="cs-cta"
          >
            <Icon icon="rocket-launch" size="1.1em" />
            Quiero resultados así para mi negocio
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  function initCaseStudies() {
    const tabs = document.querySelectorAll('.cs-tab');
    const cards = document.querySelectorAll('.cs-card');
    if (!tabs.length || !cards.length) return;

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const idx = tab.getAttribute('data-case');
        tabs.forEach(t => t.classList.remove('active'));
        cards.forEach(c => c.classList.remove('active'));
        tab.classList.add('active');
        const targetCard = document.querySelector(`[data-case-card="${idx}"]`);
        if (targetCard) {
          targetCard.classList.add('active');
          animateMetrics(targetCard as HTMLElement);
        }
      });
    });

    // Animate metrics on scroll
    const section = document.getElementById('case-studies');
    if (!section) return;

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const activeCard = section.querySelector('.cs-card.active');
          if (activeCard) animateMetrics(activeCard as HTMLElement);
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.3 });

    observer.observe(section);

    function animateMetrics(card: HTMLElement) {
      const metrics = card.querySelectorAll('.cs-metric');
      metrics.forEach(metric => {
        const numEl = metric.querySelector('.cs-metric-num') as HTMLElement;
        if (!numEl) return;
        const target = parseFloat(metric.getAttribute('data-target') || '0');
        const isDecimal = metric.getAttribute('data-decimal') === 'true';
        let start: number | null = null;
        const duration = 1800;

        const step = (ts: number) => {
          if (!start) start = ts;
          const progress = Math.min((ts - start) / duration, 1);
          const eased = 1 - Math.pow(1 - progress, 3);
          const current = eased * target;
          numEl.textContent = isDecimal ? current.toFixed(1) : String(Math.floor(current));
          if (progress < 1) requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
      });
    }
  }

  document.addEventListener('astro:page-load', initCaseStudies);
</script>

<style>
  .case-studies-section {
    padding: 4rem 0;
  }

  .cs-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .cs-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 0.4rem 1rem;
    background: linear-gradient(135deg, rgba(124, 58, 237, 0.15), rgba(168, 85, 247, 0.1));
    border: 1px solid rgba(168, 85, 247, 0.25);
    border-radius: 99rem;
    font-size: 0.78rem;
    font-weight: 700;
    color: #c4b5fd;
    margin-bottom: 1rem;
  }

  .cs-header h2 {
    font-size: clamp(1.6rem, 3.5vw, 2.5rem);
    color: var(--gray-0, white);
    margin: 0 0 0.5rem;
  }

  .cs-tagline {
    color: var(--gray-300, #94a3b8);
    font-size: 1rem;
    max-width: 600px;
    margin: 0 auto;
  }

  .cs-tabs {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    margin-bottom: 2rem;
    flex-wrap: wrap;
  }

  .cs-tab {
    padding: 0.6rem 1.3rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(168, 85, 247, 0.15);
    border-radius: 99rem;
    color: var(--gray-300, #94a3b8);
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s;
    font-family: inherit;
  }

  .cs-tab:hover,
  .cs-tab.active {
    background: linear-gradient(135deg, #7c3aed, #a855f7);
    color: white;
    border-color: transparent;
    box-shadow: 0 4px 15px rgba(124, 58, 237, 0.3);
    transform: translateY(-2px);
  }

  .cs-card {
    display: none;
    animation: csFadeIn 0.5s ease;
  }

  .cs-card.active {
    display: block;
  }

  @keyframes csFadeIn {
    from { opacity: 0; transform: translateY(15px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .cs-card-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem;
    background: rgba(15, 12, 41, 0.6);
    border: 1px solid rgba(168, 85, 247, 0.15);
    border-radius: 24px;
    padding: 2rem;
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
  }

  .cs-visual {
    position: relative;
  }

  .cs-browser {
    border-radius: 16px;
    overflow: hidden;
    background: #0a0a0a;
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.4);
  }

  .cs-browser-dots {
    display: flex;
    gap: 6px;
    padding: 10px 14px;
    background: rgba(20, 20, 20, 0.9);
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .cdot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }
  .cred { background: #ff5f56; }
  .cyellow { background: #ffbd2e; }
  .cgreen { background: #27c93f; }

  .cs-browser img {
    width: 100%;
    height: 260px;
    object-fit: cover;
    object-position: top;
    display: block;
    transition: transform 0.5s ease;
  }

  .cs-card.active .cs-browser img {
    animation: csImageReveal 0.8s ease;
  }

  @keyframes csImageReveal {
    from { opacity: 0; transform: scale(1.05); }
    to { opacity: 1; transform: scale(1); }
  }

  .cs-verified {
    position: absolute;
    bottom: -10px;
    left: 50%;
    transform: translateX(-50%);
    background: linear-gradient(135deg, #059669, #10b981);
    color: white;
    padding: 0.35rem 1rem;
    border-radius: 99rem;
    font-size: 0.72rem;
    font-weight: 700;
    box-shadow: 0 4px 12px rgba(16, 185, 129, 0.4);
    white-space: nowrap;
  }

  .cs-details {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .cs-client-info h3 {
    font-size: 1.4rem;
    color: white;
    margin: 0;
  }

  .cs-type {
    font-size: 0.8rem;
    color: #a78bfa;
    font-weight: 600;
  }

  .cs-story {
    color: rgba(255, 255, 255, 0.65);
    font-size: 0.9rem;
    line-height: 1.6;
    margin: 0;
  }

  .cs-metrics {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
  }

  .cs-metric {
    text-align: center;
    padding: 0.85rem 0.5rem;
    background: rgba(124, 58, 237, 0.08);
    border: 1px solid rgba(168, 85, 247, 0.15);
    border-radius: 14px;
    transition: all 0.3s;
  }

  .cs-metric:hover {
    background: rgba(124, 58, 237, 0.15);
    border-color: rgba(168, 85, 247, 0.3);
    transform: translateY(-2px);
  }

  .cs-metric-num {
    font-size: 1.5rem;
    font-weight: 800;
    color: #a855f7;
    font-variant-numeric: tabular-nums;
  }

  .cs-metric-suffix {
    font-size: 1rem;
    font-weight: 700;
    color: #a855f7;
  }

  .cs-metric-label {
    display: block;
    font-size: 0.68rem;
    color: rgba(255, 255, 255, 0.5);
    margin-top: 4px;
    line-height: 1.3;
  }

  .cs-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 0.85rem 1.5rem;
    background: linear-gradient(135deg, #7c3aed, #a855f7);
    border: none;
    border-radius: 14px;
    color: white;
    font-size: 0.95rem;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.3s;
    margin-top: auto;
  }

  .cs-cta:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 30px rgba(124, 58, 237, 0.5);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .cs-card-inner {
      grid-template-columns: 1fr;
      gap: 1.5rem;
      padding: 1.5rem;
    }

    .cs-metrics {
      grid-template-columns: repeat(3, 1fr);
      gap: 0.5rem;
    }

    .cs-metric-num {
      font-size: 1.2rem;
    }

    .cs-metric-label {
      font-size: 0.62rem;
    }

    .cs-browser img {
      height: 200px;
    }
  }

  @media (max-width: 480px) {
    .cs-tabs {
      gap: 0.35rem;
    }

    .cs-tab {
      font-size: 0.75rem;
      padding: 0.45rem 0.9rem;
    }
  }
</style>
