---
// ProductSavingsCalculator.astro
// Interactive Software & Apps Savings Calculator for Mateo Ferrer's Digital Store
import Icon from "./Icon.astro";

const softwareItems = [
  {
    id: "canva",
    name: "Canva Pro (1 Año)",
    category: "Diseño & Creatividad",
    icon: "🎨",
    officialCop: 250000,
    mateoCop: 40000,
    officialUsd: 65,
    mateoUsd: 10,
    popular: true,
    desc: "Plantillas ilimitadas, quitafondos pro y kit de marca.",
  },
  {
    id: "adobe",
    name: "Adobe Creative Cloud",
    category: "Suite Creativa",
    icon: "🖌️",
    officialCop: 1800000,
    mateoCop: 120000,
    officialUsd: 450,
    mateoUsd: 30,
    popular: true,
    desc: "Photoshop, Illustrator, Premiere Pro, After Effects y más.",
  },
  {
    id: "office",
    name: "Microsoft 365 + 1TB",
    category: "Productividad",
    icon: "💼",
    officialCop: 340000,
    mateoCop: 80000,
    officialUsd: 85,
    mateoUsd: 20,
    popular: false,
    desc: "Word, Excel, PowerPoint y 1000 GB de almacenamiento OneDrive.",
  },
  {
    id: "windows",
    name: "Windows 11 Pro Original",
    category: "Sistema Operativo",
    icon: "💻",
    officialCop: 850000,
    mateoCop: 45000,
    officialUsd: 210,
    mateoUsd: 12,
    popular: true,
    desc: "Licencia perpetua original, actualizaciones oficiales y soporte.",
  },
  {
    id: "spotify",
    name: "Spotify Premium (1 Año)",
    category: "Música & Streaming",
    icon: "🎵",
    officialCop: 190000,
    mateoCop: 50000,
    officialUsd: 48,
    mateoUsd: 13,
    popular: true,
    desc: "Música sin anuncios, descargas ilimitadas y máxima calidad.",
  },
  {
    id: "youtube",
    name: "YouTube Premium (1 Año)",
    category: "Video & Streaming",
    icon: "▶️",
    officialCop: 210000,
    mateoCop: 50000,
    officialUsd: 55,
    mateoUsd: 13,
    popular: false,
    desc: "Cero publicidad, reproducción en segundo plano y YouTube Music.",
  },
  {
    id: "nordvpn",
    name: "NordVPN (1 Año)",
    category: "Ciberseguridad",
    icon: "🛡️",
    officialCop: 360000,
    mateoCop: 90000,
    officialUsd: 90,
    mateoUsd: 23,
    popular: false,
    desc: "Privacidad total, navegación encriptada y desbloqueo de streaming.",
  },
  {
    id: "notion",
    name: "Pack Plantillas Notion OS",
    category: "Organización",
    icon: "📝",
    officialCop: 220000,
    mateoCop: 35000,
    officialUsd: 55,
    mateoUsd: 9,
    popular: false,
    desc: "Sistemas completos de gestión personal, finanzas y proyectos.",
  },
];
---

<section id="savings-calculator" class="savings-section wrapper reveal">
  <div class="savings-card">
    <div class="savings-header">
      <div class="savings-badge">
        <Icon icon="trophy" size="1.1em" />
        <span>Precios Transparentes & Ahorro Directo</span>
      </div>
      <h2>Calculadora de Ahorro en Software & Apps</h2>
      <p class="savings-tagline">
        Selecciona las herramientas que utilizas o necesitas. Compara el costo oficial de mercado contra los precios preferenciales de Mateo y calcula tu ahorro inmediato.
      </p>

      <div class="currency-toggle-wrapper">
        <span class="curr-label">Moneda:</span>
        <div class="currency-switch">
          <button type="button" class="calc-curr-btn active" data-curr="COP">🇨🇴 COP ($)</button>
          <button type="button" class="calc-curr-btn" data-curr="USD">🇺🇸 USD ($)</button>
        </div>
      </div>
    </div>

    <div class="savings-grid">
      <!-- Product Selection List -->
      <div class="software-selection">
        <div class="selection-top-bar">
          <span class="selection-title">Selecciona tus aplicaciones:</span>
          <button type="button" id="select-all-calc" class="select-all-btn">Seleccionar Todo</button>
        </div>

        <div class="items-list">
          {softwareItems.map((item, idx) => {
            const savingsPercentCop = Math.round(((item.officialCop - item.mateoCop) / item.officialCop) * 100);
            const isInitiallyChecked = idx === 0 || idx === 3 || idx === 4; // Canva, Windows, Spotify pre-selected
            return (
              <label class="software-item-row" data-id={item.id}>
                <input
                  type="checkbox"
                  class="calc-checkbox"
                  data-id={item.id}
                  data-name={item.name}
                  data-official-cop={item.officialCop}
                  data-mateo-cop={item.mateoCop}
                  data-official-usd={item.officialUsd}
                  data-mateo-usd={item.mateoUsd}
                  checked={isInitiallyChecked}
                />
                <div class="row-checkbox-custom">
                  <span class="chk-check">✓</span>
                </div>
                <div class="row-icon">{item.icon}</div>
                <div class="row-info">
                  <div class="row-title-line">
                    <span class="row-name">{item.name}</span>
                    {item.popular && <span class="badge-pop">Popular</span>}
                  </div>
                  <span class="row-desc">{item.desc}</span>
                </div>
                <div class="row-prices">
                  <span class="price-official" data-cop={item.officialCop} data-usd={item.officialUsd}>
                    ${item.officialCop.toLocaleString('es-CO')}
                  </span>
                  <span class="price-mateo" data-cop={item.mateoCop} data-usd={item.mateoUsd}>
                    ${item.mateoCop.toLocaleString('es-CO')}
                  </span>
                  <span class="badge-discount">-{savingsPercentCop}%</span>
                </div>
              </label>
            );
          })}
        </div>
      </div>

      <!-- Live Summary & Checkout Box -->
      <div class="savings-summary-box">
        <div class="summary-card">
          <div class="summary-header">
            <h3>Resumen de tu Pack</h3>
            <span id="selected-count-badge" class="count-badge">3 seleccionados</span>
          </div>

          <div class="summary-metrics">
            <div class="metric-row">
              <span class="metric-label">Precio Oficial Mercado:</span>
              <span id="calc-official-total" class="metric-value strikethrough">$1.290.000 COP</span>
            </div>
            <div class="metric-row highlight-row">
              <span class="metric-label">Tu Precio con Mateo:</span>
              <span id="calc-mateo-total" class="metric-value mateo-val">$135.000 COP</span>
            </div>
            <div class="savings-highlight-box">
              <div class="savings-tag">🎉 ¡ESTÁS AHORRANDO!</div>
              <div id="calc-savings-total" class="savings-amount">$1.155.000 COP</div>
              <div id="calc-savings-percent" class="savings-pct">Ahorras un 89% del costo oficial</div>
            </div>
          </div>

          <!-- Trust Badges -->
          <div class="calc-trust-list">
            <div class="trust-point">
              <span class="trust-icon">⚡</span>
              <span><strong>Activación Rápida:</strong> En menos de 15 minutos</span>
            </div>
            <div class="trust-point">
              <span class="trust-icon">🔒</span>
              <span><strong>Garantía Total:</strong> Soporte directo 1-a-1</span>
            </div>
            <div class="trust-point">
              <span class="trust-icon">💳</span>
              <span><strong>Pagos:</strong> Nequi, Daviplata, Bancolombia o Wompi</span>
            </div>
          </div>

          <!-- Direct WhatsApp Order Button -->
          <a
            id="calc-whatsapp-btn"
            href="https://wa.me/573005059987"
            target="_blank"
            rel="noopener noreferrer"
            class="calc-order-btn"
          >
            <Icon icon="paper-plane-tilt" size="1.3em" />
            <span>Pedir Pack por WhatsApp</span>
          </a>

          <a href="/shop/" class="calc-shop-link">
            Explorar todo el catálogo en la Tienda →
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
(function() {
  function initSavingsCalc() {
    var container = document.getElementById('savings-calculator');
    if (!container) return;

    var checkboxes = container.querySelectorAll('.calc-checkbox');
    var currBtns = container.querySelectorAll('.calc-curr-btn');
    var selectAllBtn = document.getElementById('select-all-calc');
    var officialTotalEl = document.getElementById('calc-official-total');
    var mateoTotalEl = document.getElementById('calc-mateo-total');
    var savingsTotalEl = document.getElementById('calc-savings-total');
    var savingsPctEl = document.getElementById('calc-savings-percent');
    var countBadgeEl = document.getElementById('selected-count-badge');
    var whatsappBtn = document.getElementById('calc-whatsapp-btn');

    var currentCurrency = 'COP';

    function formatMoney(amount, curr) {
      if (curr === 'COP') {
        return '$' + Math.round(amount).toLocaleString('es-CO') + ' COP';
      } else {
        return '$' + Math.round(amount).toLocaleString('en-US') + ' USD';
      }
    }

    function updateCalculations() {
      var totalOfficial = 0;
      var totalMateo = 0;
      var count = 0;
      var selectedNames = [];

      checkboxes.forEach(function(cb) {
        var row = cb.closest('.software-item-row');
        if (cb.checked) {
          row.classList.add('row-selected');
          var off = currentCurrency === 'COP' ? Number(cb.dataset.officialCop) : Number(cb.dataset.officialUsd);
          var mat = currentCurrency === 'COP' ? Number(cb.dataset.mateoCop) : Number(cb.dataset.mateoUsd);
          totalOfficial += off;
          totalMateo += mat;
          count++;
          selectedNames.push(cb.dataset.name);
        } else {
          row.classList.remove('row-selected');
        }

        // Update row price labels according to currency
        var pOff = row.querySelector('.price-official');
        var pMat = row.querySelector('.price-mateo');
        if (pOff && pMat) {
          if (currentCurrency === 'COP') {
            pOff.textContent = '$' + Number(cb.dataset.officialCop).toLocaleString('es-CO');
            pMat.textContent = '$' + Number(cb.dataset.mateoCop).toLocaleString('es-CO');
          } else {
            pOff.textContent = '$' + Number(cb.dataset.officialUsd).toLocaleString('en-US');
            pMat.textContent = '$' + Number(cb.dataset.mateoUsd).toLocaleString('en-US');
          }
        }
      });

      var savings = totalOfficial - totalMateo;
      var pct = totalOfficial > 0 ? Math.round((savings / totalOfficial) * 100) : 0;

      if (countBadgeEl) {
        countBadgeEl.textContent = count + ' seleccionado' + (count === 1 ? '' : 's');
      }

      if (officialTotalEl) officialTotalEl.textContent = formatMoney(totalOfficial, currentCurrency);
      if (mateoTotalEl) mateoTotalEl.textContent = formatMoney(totalMateo, currentCurrency);
      if (savingsTotalEl) savingsTotalEl.textContent = formatMoney(savings, currentCurrency);
      if (savingsPctEl) {
        savingsPctEl.textContent = count > 0 
          ? '¡Ahorras un ' + pct + '% respecto al costo oficial!' 
          : 'Selecciona al menos una aplicación para calcular tu ahorro.';
      }

      // Update WhatsApp URL
      if (whatsappBtn) {
        if (count === 0) {
          whatsappBtn.href = "https://wa.me/573005059987?text=" + encodeURIComponent("Hola Mateo, quiero consultar por software y apps para mi trabajo.");
        } else {
          var msg = "¡Hola Mateo! Usé la Calculadora de Ahorro en tu web y quiero adquirir este pack:\n\n" +
            selectedNames.map(function(n) { return "• " + n; }).join("\n") +
            "\n\nTotal con descuento: " + formatMoney(totalMateo, currentCurrency) +
            "\n(Ahorro de " + formatMoney(savings, currentCurrency) + ")" +
            "\n\n¿Cuáles son los pasos para la activación?";
          whatsappBtn.href = "https://wa.me/573005059987?text=" + encodeURIComponent(msg);
        }
      }
    }

    checkboxes.forEach(function(cb) {
      cb.addEventListener('change', updateCalculations);
    });

    currBtns.forEach(function(btn) {
      btn.addEventListener('click', function() {
        currBtns.forEach(function(b) { b.classList.remove('active'); });
        btn.classList.add('active');
        currentCurrency = btn.dataset.curr || 'COP';
        updateCalculations();
      });
    });

    if (selectAllBtn) {
      selectAllBtn.addEventListener('click', function() {
        var allChecked = Array.from(checkboxes).every(function(cb) { return cb.checked; });
        checkboxes.forEach(function(cb) { cb.checked = !allChecked; });
        selectAllBtn.textContent = allChecked ? 'Seleccionar Todo' : 'Deseleccionar Todo';
        updateCalculations();
      });
    }

    updateCalculations();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSavingsCalc);
  } else {
    initSavingsCalc();
  }
  document.addEventListener('astro:page-load', initSavingsCalc);
})();
</script>

<style>
  .savings-section {
    margin-top: 3.5rem;
    margin-bottom: 3.5rem;
  }

  .savings-card {
    background: radial-gradient(circle at 85% 15%, rgba(124, 58, 237, 0.14) 0%, rgba(15, 23, 42, 0.85) 90%);
    border: 1px solid rgba(168, 85, 247, 0.3);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-radius: 1.5rem;
    padding: 2.5rem;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.4), 0 0 30px rgba(124, 58, 237, 0.15);
    position: relative;
    overflow: hidden;
  }

  .savings-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, #ec4899, #8b5cf6, #3b82f6);
  }

  .savings-header {
    text-align: center;
    max-width: 760px;
    margin: 0 auto 2.5rem;
  }

  .savings-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(124, 58, 237, 0.2);
    border: 1px solid rgba(168, 85, 247, 0.4);
    color: #c4b5fd;
    padding: 0.4rem 1rem;
    border-radius: 9999px;
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 1rem;
  }

  .savings-header h2 {
    font-size: clamp(1.8rem, 4vw, 2.5rem);
    font-weight: 800;
    color: var(--gray-0, #fff);
    margin-bottom: 0.75rem;
    line-height: 1.2;
  }

  .savings-tagline {
    color: var(--gray-300, #cbd5e1);
    font-size: 1.05rem;
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  .currency-toggle-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
  }

  .curr-label {
    font-size: 0.9rem;
    color: var(--gray-400, #94a3b8);
    font-weight: 500;
  }

  .currency-switch {
    display: inline-flex;
    background: rgba(15, 23, 42, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 9999px;
    padding: 0.25rem;
    gap: 0.25rem;
  }

  .calc-curr-btn {
    background: transparent;
    border: none;
    color: var(--gray-400, #94a3b8);
    padding: 0.4rem 0.9rem;
    border-radius: 9999px;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .calc-curr-btn.active {
    background: linear-gradient(135deg, #7c3aed, #6366f1);
    color: #fff;
    box-shadow: 0 2px 10px rgba(124, 58, 237, 0.4);
  }

  .savings-grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 2rem;
    align-items: start;
  }

  @media (max-width: 960px) {
    .savings-grid {
      grid-template-columns: 1fr;
    }
  }

  .selection-top-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
  }

  .selection-title {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--gray-200, #e2e8f0);
  }

  .select-all-btn {
    background: none;
    border: none;
    color: #a78bfa;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    text-decoration: underline;
    transition: color 0.2s;
  }

  .select-all-btn:hover {
    color: #c4b5fd;
  }

  .items-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .software-item-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.25rem;
    background: rgba(15, 23, 42, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 1rem;
    cursor: pointer;
    transition: all 0.25s ease;
    user-select: none;
  }

  .software-item-row:hover {
    background: rgba(124, 58, 237, 0.1);
    border-color: rgba(168, 85, 247, 0.4);
    transform: translateX(4px);
  }

  .software-item-row.row-selected {
    background: rgba(124, 58, 237, 0.15);
    border-color: rgba(168, 85, 247, 0.6);
    box-shadow: 0 4px 15px rgba(124, 58, 237, 0.15);
  }

  .calc-checkbox {
    display: none;
  }

  .row-checkbox-custom {
    width: 22px;
    height: 22px;
    border-radius: 6px;
    border: 2px solid rgba(255, 255, 255, 0.3);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: all 0.2s;
    background: rgba(0, 0, 0, 0.2);
  }

  .chk-check {
    display: none;
    font-size: 0.8rem;
    font-weight: 900;
    color: #fff;
  }

  .calc-checkbox:checked + .row-checkbox-custom {
    background: linear-gradient(135deg, #10b981, #059669);
    border-color: #10b981;
  }

  .calc-checkbox:checked + .row-checkbox-custom .chk-check {
    display: block;
  }

  .row-icon {
    font-size: 1.6rem;
    flex-shrink: 0;
  }

  .row-info {
    flex-grow: 1;
    min-width: 0;
  }

  .row-title-line {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.2rem;
  }

  .row-name {
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--gray-0, #fff);
  }

  .badge-pop {
    background: linear-gradient(135deg, #f59e0b, #d97706);
    color: #000;
    font-size: 0.65rem;
    font-weight: 800;
    text-transform: uppercase;
    padding: 0.15rem 0.45rem;
    border-radius: 9999px;
  }

  .row-desc {
    font-size: 0.78rem;
    color: var(--gray-400, #94a3b8);
    display: block;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .row-prices {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.15rem;
    flex-shrink: 0;
  }

  .price-official {
    font-size: 0.75rem;
    color: var(--gray-500, #64748b);
    text-decoration: line-through;
  }

  .price-mateo {
    font-size: 0.95rem;
    font-weight: 800;
    color: #4ade80;
  }

  .badge-discount {
    background: rgba(239, 68, 68, 0.2);
    border: 1px solid rgba(239, 68, 68, 0.4);
    color: #f87171;
    font-size: 0.65rem;
    font-weight: 700;
    padding: 0.1rem 0.35rem;
    border-radius: 4px;
  }

  /* Summary Box */
  .summary-card {
    background: rgba(10, 15, 30, 0.75);
    border: 1px solid rgba(168, 85, 247, 0.35);
    border-radius: 1.25rem;
    padding: 1.75rem;
    position: sticky;
    top: 2rem;
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.5);
  }

  .summary-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    margin-bottom: 1.25rem;
  }

  .summary-header h3 {
    font-size: 1.2rem;
    font-weight: 800;
    color: #fff;
    margin: 0;
  }

  .count-badge {
    background: rgba(124, 58, 237, 0.3);
    color: #c4b5fd;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.25rem 0.65rem;
    border-radius: 9999px;
  }

  .summary-metrics {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  .metric-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.95rem;
    color: var(--gray-300, #cbd5e1);
  }

  .metric-value.strikethrough {
    text-decoration: line-through;
    color: var(--gray-500, #64748b);
  }

  .highlight-row {
    font-size: 1.05rem;
    font-weight: 700;
    color: #fff;
  }

  .metric-value.mateo-val {
    color: #4ade80;
    font-size: 1.2rem;
    font-weight: 900;
  }

  .savings-highlight-box {
    background: linear-gradient(135deg, rgba(16, 185, 129, 0.15), rgba(124, 58, 237, 0.15));
    border: 1px solid rgba(16, 185, 129, 0.4);
    border-radius: 1rem;
