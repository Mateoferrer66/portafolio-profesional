    border-radius: 0.75rem;
  }

  .trust-point {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.8rem;
    color: var(--gray-300, #cbd5e1);
  }

  .trust-icon {
    font-size: 1rem;
    flex-shrink: 0;
  }

  .calc-order-btn {
    display: flex;
    align-items: center;
    justify-content: center;
